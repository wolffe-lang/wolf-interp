//! check: run(exit=0)
//! phase: resolve
//! conforms: task.scope, task.channel, task.select, proc.spawn, proc.monitor, sync.when
//!
//! Concurrency surface (D13–D16): scoped spawn only, typed channels,
//! `select` with timeout arms, procs under the root supervisor with
//! `monitor`, region `move` through a channel, and `when (a, b)`
//! multi-acquire (deadlock-free by ordered set acquisition).
//! NOTE: exact API names ride the s05 spec — corpus updates land in the
//! same commit as spec surface changes (s02 discipline).
//! Self-contained since 2026-08-10 (is06 finding S-5): every function
//! the file calls is defined in the file.

fn build_batch() -> List[int] {
    var xs = List[int]()
    for i in 0..4 { (mut xs).push(i * i) }
    xs
}

fn worker() -> int {
    0                                    // exits normal(0): is_normal() holds
}

fn main() -> !int {
    var sum = 0
    scope s {                            // D16: no global spawn exists
        let ch = channel[int](4)
        s.spawn(fn() {
            for i in 1..=10 { ch.send(i) }
            ch.close()
        })
        for v in ch { sum += v }
    }                                    // scope exit joins all children

    // region transfer: the whole graph moves, zero-copy (D14 `move`)
    let results = channel[region](2)
    scope s2 {
        s2.spawn(fn() {
            let r = region()
            let data = in r { build_batch() }
            results.send(move r)         // sender's later use = compile error
        })
        let got = results.recv()?
    }

    // procs: failure domains; monitoring is a method, not a keyword
    let w = spawn proc worker()          // under the root supervisor, named
    let m = w.monitor()                  // delivers the exit *reason*
    select {
        exit(reason) from m => { if !reason.is_normal() { return 1 } },
        timeout(1.s) => { return 1 },     // member access on int literal: [gram.amb.intdot]
    }

    // shared-mutable requires a sync wrapper; `when` acquires as a set
    let a = Mutex(0)
    let b = Mutex(0)
    when (a, b) {                        // BoC-style: no lock-order deadlocks
        a += 1
        b += sum
    }
    if sum == 55 { 0 } else { 1 }
}
