//! check: run(exit=0)
//! phase: run
//! conforms: gram.pat
//!
//! s131 (#196) pinned this at `mem` as the c06 residue's or-pattern
//! half: an or-pattern INSIDE a product pattern (`Pair(1 | 2, b)` — an
//! alternation in one payload slot) refused by name on the native pipe
//! ("or-patterns inside product patterns (join params)"), while the
//! checked executor and lupin 0.1.20 both ran it.
//!
//! s168 lands it, and the pin's own name turns out to have been too
//! pessimistic. The product walk is a CONJUNCTION of pure tests, so an
//! alternation in a slot is a DISJUNCTION of that slot's tests and
//! needs no join at all — each alternative's conjunction folds to one
//! BOOL and the alternatives are `bor`'d together. Join params are
//! needed only when an alternative BINDS, because then the same name
//! arrives from different slots on different edges; that shape stays
//! refused, now under its own name, and its witness is the sibling
//! `match_arm_or_over_product`.

enum Shape {
    Empty,
    Pair(int, int),
}

fn score(s: Shape) -> int {
    match s {
        Empty => 0,
        Pair(1 | 2, b) => b * 10,
        Pair(a, b) => a + b,
    }
}

fn main() -> !int {
    let low = score(Shape.Pair(2, 3))
    let hi = score(Shape.Pair(7, 1))
    if low == 30 && hi == 8 { 0 } else { 1 }
}
