//! check: fail(E0817)
//! phase: resolve
//! conforms: gram.item.attr
//!
//! kw01 (K13 — wolf-lang#519, lc00's shape): every argument of `repr`
//! and every attribute beside it is read. `bogus` is no representation,
//! `packed(3)` is not implemented, and `align(7)` is not an attribute
//! at all (alignment is a `repr` argument): three refusals, one per
//! item, all on one line that compiled silently at trunk.

#[repr(bogus, packed(3)), align(7)]
struct R {
    a: u8,
    b: u32,
}

fn main() -> int {
    let r = R { a: 1, b: 2 }
    r.a as int - 1
}
