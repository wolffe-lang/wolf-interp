//! check: run(exit=0)
//! phase: run
//! conforms: gram.pat
//!
//! s130 (#179) pinned this at `mem` as the c06 RESIDUE after the
//! product domain landed: an enum (or row) test INSIDE a product
//! pattern — the deep-tree class — refused by name on the native pipe,
//! while the checked executor ran it, and the pin promised "the day
//! deep trees land, `phase:` advances to `run` in the same commit".
//!
//! s168 is that day. A payload-carrying case value is an aggregate
//! whose slot 0 is the tag, exactly as at the top level, so the nested
//! test is the same `icmp` against a domain built from the FIELD's own
//! sema type — and the payload slots recurse straight back into the
//! product walk, which is what makes the tree deep rather than one
//! level. Every lane runs this file now.

enum Pairs {
    Empty,
    Pair(int, int),
}

struct Box {
    p: Pairs,
    k: int,
}

fn probe(b: Box) -> int {
    match b {
        Box { p: Pair(a, _), .. } => a,
        Box { k, .. } => k,
    }
}

fn main() -> !int {
    if probe(Box { p: Pairs.Pair(7, 1), k: 3 }) != 7 { return 1 }
    0
}
