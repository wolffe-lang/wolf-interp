//! check: run(exit=0)
//! phase: run
//! conforms: gram.pat.struct
//!
//! s129 (#179) pinned this file at phase mem: sema typed the arm and
//! proved the product exhaustive (the `y` column splits over bool and
//! `..`/`_` cover the rest — total without a wildcard), while BOTH
//! lowerings refused product patterns in arm position by name — the
//! c06 family that also held tuples out of arms, kept symmetric on
//! purpose. s130 retires the deferral: the arm compiles to a
//! conjunction of field tests plus field binds on the native pipe,
//! and the checked executor matches the same shapes value-wise. This
//! is the pinned "must advance loudly" payoff — the phase moved to
//! `run` in the same commit that landed the product match domain.

struct Flag {
    on: bool,
    n: int,
}

fn main() -> !int {
    let f = Flag { on: true, n: 3 }
    let r = match f {
        Flag { on: true, n } => n,
        Flag { on: false, .. } => 0,
    }
    if r != 3 { return 1 }
    0
}
