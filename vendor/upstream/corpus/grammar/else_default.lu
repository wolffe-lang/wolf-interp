//! check: run(exit=0, stdout="fell back: parse")
//! phase: run
//! conforms: gram.amb.else, type.interp.row
//! `else` after a complete expression is the defaulting operator (D30).
//! Pinned at resolve until s143 (wolf-lang#268): the `{err}` hole in
//! the third fallback was "string interpolation of a non-primitive
//! value"; a caught row renders as its tag's name now
//! (`[type.interp.row]`), so the file runs on both tiers. The tag is
//! `to_int`'s `parse` (`[mem.str.parse]`; lupin 0.1.28 still spells
//! it `NotAnInt` — the mirror is the same wave's).

fn parse(s: str) -> !int { s.to_int() }

fn main() -> !int {
    let a = parse("7") else 0
    let b = parse("x") else 0
    let c = parse("x") else |err| { print("fell back: {err}"); 1 }
    if a == 7 && b == 0 && c == 1 { 0 } else { 1 }
}
