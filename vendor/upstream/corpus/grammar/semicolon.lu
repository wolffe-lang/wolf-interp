//! check: fail(E0002)
//! phase: lex
//! conforms: gram.lex.newline
//! `;` is legal only as a statement separator (single-line blocks). An
//! empty statement — a stray `;` — does NOT parse.

fn main() -> !int {
    ;              // ERROR E0002: empty statement
    let x = 1;     // trailing `;` here is legal (formatter strips it)
    if x == 1 { print("ok"); return 0 }   // the idiom `;` exists for
    1
}
