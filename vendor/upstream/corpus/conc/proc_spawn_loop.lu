//! check: run(exit=0)
//! phase: run
//! conforms: conc.proc.root, conc.task.root
//! The s86/s87 boundary, made checkable instead of asserted in prose.
//!
//! s86 taught TASK spawn to run under a loop: a task belongs to a
//! `scope`, the scope is an extent, and the extent owns an arena the
//! per-iteration capture record lives in (`spawn_fanout_loop.lu` is
//! the witness). A PROC has no such extent — it is a failure domain
//! under the ROOT supervisor and outlives its spawner by design, so
//! nothing at the spawn site is entitled to free its environment.
//!
//! s87's answer ([abi.native.procenv]): the runtime COPIES the
//! argument record before the spawn returns, and the proc's own frame
//! owns the copy until its body returns. One record slot per site is
//! then sound under a loop — the slot is free the instant the id is
//! back. This header advanced from `mem` to `run` in the commit that
//! shipped that; the diff is the sprint's evidence. (The per-proc
//! value check lives in wolf_rt's `proc_env_is_copied_at_spawn`: a
//! proc's only outputs are its exit class and stdout, so the copy is
//! pinned where a body can be gated and observed.)

fn worker(n: int) -> int { n }

fn main() -> !int {
    var seen = 0
    for i in 1..=3 {
        let w = spawn proc worker(i)
        seen += 1
    }
    if seen == 3 { 0 } else { 1 }
}
