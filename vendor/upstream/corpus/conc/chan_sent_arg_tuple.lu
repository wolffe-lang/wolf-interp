//! check: fail(E1010)
//! phase: typecheck
//! conforms: conc.chan.payload, mem.region.escape
//!
//! s229 (wolf-lang#665): a tuple payload holding a region-built `str`.
//! A callee handed a channel may send what it is handed, so at the call
//! every argument that can name region bytes — and what the callee may
//! build in the caller's current region — is demanded to outlive the
//! frame, as a sent payload is. Before s229 the compiler built it:
//! native and release printed the chunk the next region reused
//! (`ZZZZZZZZZZZZZZZZZZZZZ`), the checked machine the stale bytes;
//! lupin traps `region-fault`.

fn fwd_p(ch: channel[(int, str)], p: (int, str)) {
    ch.send(p) else {}
}

fn main() -> int {
    region st {
        let seq0 = 0
        let ch = channel[(int, str)](1)
        region pass {
            let s = "built in pass, {seq0} uses"
            fwd_p(ch, (7, s))
        }
        region other {
            let z = "ZZZZZZZZZZZZZZZZZZZZZZZZZ{seq0}ZZ"
            print("{z.len}")
        }
        let got = ch.recv() else (0, "?")
        print("{got.1}")
    }
    0
}
