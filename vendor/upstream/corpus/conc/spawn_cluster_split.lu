fn main() -> !int {
    var got = 0
    scope s {
        let ch = channel[int](1)
        s.spawn(fn() { ch.send(7) })
        got = ch.recv()?
    }
    let sink = alpha(5) % 10 + beta(4) % 10
    print("{got}")
    if got == 7 && sink >= 0 { 0 } else { 1 }
}
