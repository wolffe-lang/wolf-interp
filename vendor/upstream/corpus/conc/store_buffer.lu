//! check: fail(E1101)
//! phase: resolve
//! conforms: conc.task.spawn, conc.mm.advice
//! warns: W1101, W1102
//! The store-buffer litmus is INEXPRESSIBLE in safe wolf: two tasks
//! capturing plain mutable state don't typecheck. This file is the
//! proof-by-error — the classic relaxed-memory shape dies at compile.

fn main() -> !int {
    var x = 0
    var y = 0
    var r1 = 0
    var r2 = 0
    scope s {
        s.spawn(fn() { x = 1; r1 = y })   // ERROR E1101: unsynchronized
        s.spawn(fn() { y = 1; r2 = x })   //   mutable capture across tasks
    }
    r1 + r2
}
