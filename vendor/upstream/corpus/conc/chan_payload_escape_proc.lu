//! check: fail(E1010)
//! phase: typecheck
//! conforms: mem.region.proc, conc.chan.payload, mem.region.escape
//!
//! s160 (wolf-lang#355) — the proc half of `[conc.chan.payload]`'s
//! lifetime rule. `[mem.region.create.3]` gives a function body its
//! CALLER's current region; a `spawn proc` entry has no such caller —
//! `[conc.proc.1]` makes the proc its own failure domain owning its
//! regions and `[conc.proc.kill]` step 3 bulk-frees them at exit. So
//! the proc's ambient is a region frame-local to the proc
//! (`[mem.region.proc]`), and a `str` built there and SENT is the
//! same escape `region_str_concat_send.lu` pins one scope in: the
//! payload crosses as its view (`[conc.chan.imm]` — the bytes stay
//! where they were built), and the bytes die with the proc.
//!
//! Before s160 both tiers accepted this: the compiler saw the
//! immortal caller region, and the native tier's root arena never
//! frees, so `wolf run` printed `built 7 here` and exited 0 while
//! lupin 0.1.34 — which models the proc's region — trapped
//! `region-fault`. The fix is the parameter form: build the bytes in
//! the supervisor and hand them in (`chan_payload_proc_param.lu`).

fn worker(n: int, out: channel[str]) -> !int {
    out.send("built {n} here")?          // ERROR E1010: built in proc:worker
    0
}

fn main() -> !int {
    let out = channel[str](4)
    let c = spawn proc worker(7, out)
    let m = c.monitor()
    select {
        exit(reason) from m => {},
        timeout(1.s) => { return 1 },
    }
    out.close()
    for line in out { print(line) }
    0
}
