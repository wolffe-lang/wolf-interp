//! check: run(exit=0)
//! phase: typecheck
//! conforms: conc.mm.hb.freeze, mem.region.freeze.1
//! `freeze` happens-before every cross-task read: imm data is shared by
//! reference, no copies, no synchronization.

fn main() -> !int {
    let table = freeze region {
        var xs = List[int]()
        for i in 0..10 { (mut xs).push(i * i) }
        xs
    }
    let ch = channel[int](2)
    scope s {
        s.spawn(fn() { ch.send(table[3]) })   // imm: capture by shared read
        s.spawn(fn() { ch.send(table[4]) })
    }
    let a = ch.recv() else |_| { return 1 }
    let b = ch.recv() else |_| { return 1 }
    if a + b == 25 { 0 } else { 1 }
}
