//! check: run(exit=0, stdout="3 12\n")
//! phase: run
//! conforms: conc.chan.close, mem.iter.range
//! The ch12 ex12-6 router shape, minimized (s74, #66). An INCLUSIVE
//! `for` whose body can exit early leaves its loop-exit block created
//! late; resolving a binding read after it made the Braun trivial-φ test
//! cascade, and the cascade removed the very parameter the outer removal
//! had just chosen as its replacement. The outer frame kept the dead
//! handle, so the next instruction took a phantom operand and the
//! canonical dump named a value it could not define. The exclusive form
//! never tripped it, which is what named the bug.

fn main() -> !int {
    let src = channel[int](8)
    let out = channel[int](8)
    for i in 1..=3 { src.send(i) }
    src.close()
    var relayed = 0
    for v in src {
        out.send(v * 2)
        relayed += 1
    }
    out.close()
    var sum = 0
    for v in out { sum += v }
    print("{relayed} {sum}")
    0
}
