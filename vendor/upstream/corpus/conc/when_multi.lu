//! check: run(exit=0)
//! phase: typecheck
//! conforms: conc.mm.hb.mutex, conc.when.order, conc.when.nodeadlock, conc.when.body
//! `when (a, b)` acquires the whole set at once (canonical-order
//! acquisition under the hood, [conc.when.order]): no lock-order
//! deadlock exists by construction — the reversed spelling below
//! performs the identical acquisitions.

fn main() -> !int {
    let a = Mutex(1)
    let b = Mutex(2)
    var total = 0
    scope s {
        s.spawn(fn() {
            when (a, b) { a += 10; b += 10 }
        })
        s.spawn(fn() {
            when (b, a) { b += 100; a += 100 }   // reversed order: still fine
        })
    }
    when (a, b) { total = a + b }
    if total == 223 { 0 } else { 1 }
}
