//! check: run(exit=0, stdout="13 3")
//! phase: run
//! conforms: gram.item.use
//!
//! #29's probe-close witness: module identity is the FULL path, not
//! the last segment. Two modules whose leaf is `float` coexist in one
//! program; the entry names the second through `use … as` (E0306
//! suggests exactly this when both want the same binding name), and
//! `fmt.float` itself imports `math.float` — same leaf on both sides
//! of the import, which the issue's original filing read back as an
//! E0303 self-cycle. The values prove the bindings stay distinct:
//! `fmt.float.probe` answers through `math.float.probe`, +10 apart.

use fmt.float
use math.float as mfloat

fn main() -> !int {
    print("{float.probe(1)} {mfloat.probe(1)}")
    if float.probe(1) == 13 && mfloat.probe(1) == 3 { 0 } else { 1 }
}
