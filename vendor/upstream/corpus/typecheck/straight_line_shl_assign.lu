//! check: run(exit=0, stdout="321\n")
//! phase: run
//! conforms: type.int.shift
//!
//! wolf-lang#755 (s237, s755): a function with no `if`, loop, call or
//! index is lowered as one block, and its locals are kept for that
//! block alone. A construct that branches in the middle of an
//! expression ends the block, so a local declared before it and read
//! after it had no definition: a plain `<<=` by a count that is not a
//! constant. Native and release panicked here with s237's shift
//! lowering before the #755 fix (s755) landed, the shift's own branches
//! being new, "use of a variable with no definition on some path". The
//! checked machine and lupin 0.1.52 printed what this row says.

fn f(x: int, n: int) -> int {
    let y = x + 1
    var z = x
    z <<= n
    y + z
}

fn main() {
    print("{f(64, 2)}")
}
