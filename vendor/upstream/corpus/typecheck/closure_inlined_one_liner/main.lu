use tty

fn main() -> int {
    var key = "TE"
    key = "{key}RM"
    let r = tty.render_env(key)
    var s = 0
    for i in 0..2 {
        s = (s + tty.pad_a(i)) % 1000003
        s = (s + tty.pad_b(i)) % 1000003
    }
    print("{s}")
    r
}
