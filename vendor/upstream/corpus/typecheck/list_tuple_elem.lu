//! check: run(exit=0, stdout="ada 78 2 ada 0 0\n")
//! phase: run
//! conforms: gram.amb.brackets, generics.brackets
//! s165 (wolf-lang#349) — wolf-book exercise 5-7's grade book, spelled
//! the way the maintainer's ask spelled it: a `List[(str, int)]`. At
//! v0.2.14 the constructor declined at resolve ("this prelude container
//! instantiation (generic data)") while `List[int]`, `List[str]` and a
//! `List` of a struct with the same two fields all compiled — a tuple
//! in bracket position parses as a tuple EXPRESSION of type heads
//! (D29), and the bracket reader had no arm for it. The element type
//! crosses a signature, a `for`, and a `Map` value; lupin 0.1.36 prints
//! the same line.

fn best(xs: List[(str, int)]) -> str {
    var top = ""
    var hi = 0
    for p in xs {
        if p.1 > hi {
            hi = p.1
            top = p.0
        }
    }
    top
}

fn main() -> !int {
    var out = List[(str, int)]()
    (mut out).push(("ada", 91))
    (mut out).push(("grace", 78))
    let m = Map[str, (int, bool)]()
    var nested = List[List[(int, int)]]()
    print("{out[0].0} {out[1].1} {out.len} {best(out)} {m.len} {nested.len}")
    0
}
