//! check: run(exit=0)
//! phase: typecheck
//! conforms: ty.method.receiver-mode, mem.tier0.mode.mut, mem.tier0.mode.take
//!
//! X1 receiver modes: the call site spells exactly what the method
//! declares — `(mut c)` for `mut self`, `(take c)` for `take self`,
//! bare for `read self`. Exclusivity/move checking is c04's.

struct Counter {
    n: int,
}

impl Counter {
    fn get(self) -> int {
        self.n
    }

    fn bump(mut self) -> int {
        self.n = self.n + 1
        self.n
    }

    fn finish(take self) -> int {
        self.n
    }
}

fn main() -> !int {
    var c = Counter { n: 40 }
    let a = (mut c).bump()
    let b = c.get()
    let z = (take c).finish()
    if a + b + z == 123 { 0 } else { 1 }
}
