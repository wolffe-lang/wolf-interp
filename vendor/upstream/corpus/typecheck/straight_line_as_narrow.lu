//! check: run(exit=0, stdout="129\n")
//! phase: run
//! conforms: type.numlit.cast.narrow
//!
//! wolf-lang#755 (s755): a function with no `if`, loop, call or index
//! is lowered as one block, and its locals are kept for that block
//! alone. A construct that branches in the middle of an expression ends
//! the block, so a local declared before it and read after it had no
//! definition: a narrowing `as` (`int` to `i8`), which checks the value
//! against the target's range on a branch to its `overflow` trap.
//! Native and release panicked at trunk `b407c73b` (wolf 0.2.29 too),
//! "use of a variable with no definition on some path". The checked
//! machine and lupin 0.1.52 printed what this row says.

fn f(x: int) -> int {
    let y = x + 1
    let z = x as i8
    y + z as int
}

fn main() {
    print("{f(64)}")
}
