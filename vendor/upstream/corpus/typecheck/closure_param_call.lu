//! check: run(exit=0, stdout="2\n9\n")
//! phase: run
//! conforms: type.fn.value
//!
//! s157 (wolf-lang#311) — a call THROUGH an unannotated closure
//! parameter. `fn(f) f(1)` types `f` against an inference variable;
//! the call `f(1)` shapes that variable into a fn type and solves it
//! on the spot, but until this pin sema recorded no call surface for
//! the site, so lowering refused the whole program by the generic
//! name ("calls outside the resolved surface") — while the annotated
//! spelling `fn(f: fn(int) -> int) f(1)` ran. The `Var` callee arm
//! now records the surface its own unification just resolved, and
//! the body's finish zonks every recorded call, so the parameter
//! slots land solved. `compose` is the book's exercise 4-1, the
//! shape this was found on.

fn main() -> !int {
    let call1 = fn(f) f(1)
    print("{call1(fn(n) n + 1)}")
    let compose = fn(f, g) fn(x) f(g(x))
    let inc = fn(n) n + 1
    let dbl = fn(n) n * 2
    print("{compose(inc, dbl)(4)}")
    0
}
