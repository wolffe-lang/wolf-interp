//! check: run(exit=0, stdout="131\n")
//! phase: run
//! conforms: type.char.cast
//!
//! wolf-lang#755 (s755): a function with no `if`, loop, call or index
//! is lowered as one block, and its locals are kept for that block
//! alone. A construct that branches in the middle of an expression ends
//! the block, so a local declared before it and read after it had no
//! definition: `int as char`, which checks the scalar range and the
//! surrogate gap on branches. Native and release panicked at trunk
//! `b407c73b` (wolf 0.2.29 too), "use of a variable with no definition
//! on some path". The checked machine and lupin 0.1.52 printed what
//! this row says.

fn f(x: int) -> int {
    let y = x + 1
    let c = x as char
    y + c as int
}

fn main() {
    print("{f(65)}")
}
