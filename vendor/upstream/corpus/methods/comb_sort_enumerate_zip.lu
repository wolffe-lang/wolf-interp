//! check: run(exit=0, stdout="4 1 4 3 4 2 b\n")
//! phase: run
//! conforms: type.method.resolve, type.comb.set
//!
//! s166 — the bool-shaped relation (`less(a, b)`: `a` goes before `b`),
//! in place through a `mut` receiver and returning through a read one;
//! `enumerate` counts from 0 and `zip` stops at the shorter list.

fn main() -> !int {
    var xs = [4, 1, 3, 2]
    let down = xs.sorted_by(fn(a: int, b: int) { a > b })
    (mut xs).sort_by(fn(a: int, b: int) { a < b })
    let e = xs.enumerate()
    let z = xs.zip(["a", "b"])
    print("{down[0]} {xs[0]} {xs[3]} {e[3].0} {e[3].1} {z.len} {z[1].1}")
    0
}
