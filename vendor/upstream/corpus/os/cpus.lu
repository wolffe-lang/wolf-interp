//! check: run(exit=0, stdout="cpus | answered true | at_least_one true | stable true")
//! phase: run
//! conforms: os.cpus, err.union, err.propagate
//!
//! s137 (#233, `[os.cpus]`) — the count of schedulable cores. The
//! VALUE is the machine's and differs on every host and every lane's
//! runner, so this witness pins relations and nothing else (the
//! `os/args_cwd.lu` posture: a predicate, never a path):
//!
//!   answered      the host answered at all — every tier-1 host does,
//!                 and a host that cannot is the `io` row rather than
//!                 a silent 1, which is the distinction #233 was
//!                 filed about.
//!   at_least_one  the count is never 0 and never negative. A program
//!                 resolving `workers auto` can divide by it.
//!   stable        two reads in one run agree. It is the machine's
//!                 size, not a sample.

fn main() -> !int {
    var answered = true
    let n = os_cpus() else |_| {
        answered = false
        0
    }
    var at_least_one = true
    var stable = true
    if answered {
        at_least_one = n >= 1
        let again = os_cpus()?
        stable = again == n
    }
    print("cpus | answered {answered} | at_least_one {at_least_one} | stable {stable}")
    0
}
