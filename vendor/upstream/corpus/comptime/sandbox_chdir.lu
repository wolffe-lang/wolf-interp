//! check: fail(E0701)
//! phase: resolve
//! conforms: comptime.sandbox, comptime.sandbox.env, os.fs.chdir
//!
//! s215 (D33): `os_chdir` would move the COMPILER's working directory —
//! the process context `os_cwd` reads, so it is the `env` category
//! (ruling #54), refused at comptime with that category's reason.

comptime fn helper() -> int {
    os_chdir("/") else |_| {}
    0
}

fn main() -> !int {
    const H = helper()
    H
}
