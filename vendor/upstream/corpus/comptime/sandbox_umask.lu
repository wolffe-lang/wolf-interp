//! check: fail(E0701)
//! phase: resolve
//! conforms: comptime.sandbox, comptime.sandbox.env, os.fs.umask
//!
//! s230 (D33): `os_umask` would change the COMPILER's file mode creation
//! mask — process state every later creation reads, as `os_chdir`
//! changes the directory every later path reads, so it is the `env`
//! category (ruling #54's reading), refused at comptime with that
//! category's reason.

comptime fn helper() -> int {
    let old = os_umask(0o077) else |_| 0
    old
}

fn main() -> !int {
    const H = helper()
    H
}
