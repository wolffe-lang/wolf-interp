//! check: run(exit=0, stdout="3 -3 250")
//! phase: run
//! conforms: type.numlit.cast.trunc
//!
//! float→int truncates TOWARD ZERO (#138, D54.4,
//! `[type.numlit.cast.trunc]`): `3.7 as int` is `3`, `-3.7 as int` is
//! `-3` (not floor, not round). The `u32` round-trip shows the unsigned
//! target arm (`fptoui`).

fn main() -> !int {
    let x: f64 = 3.7
    let y: f64 = -3.7
    let u: u32 = 250
    let back = u as f64 as u32
    print("{x as int} {y as int} {back}")
    0
}
