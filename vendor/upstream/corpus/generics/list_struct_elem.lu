//! check: run(exit=0)
//! phase: run
//! conforms: generics.mono
//!
//! The LOCAL twin of `generics/list_imported_elem/` — the #140
//! regression pin: `List[Point]()` with a locally declared struct
//! element worked before the imported-element fix and must keep
//! working after it, byte-for-byte the same program modulo where
//! `Point` lives. Constructed, pushed twice, read back by copy.

struct Point {
    x: int,
    y: int,
}

fn main() -> !int {
    var l = List[Point]()
    (mut l).push(Point { x: 3, y: 4 })
    (mut l).push(Point { x: 10, y: 20 })
    let p = copy l[0]
    let q = copy l[1]
    if p.x + p.y + q.x + q.y == 37 { 0 } else { 1 }
}
