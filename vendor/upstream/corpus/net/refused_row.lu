//! check: run(exit=1, stdout="handled: 0\nerror: refused")
//! phase: run
//! conforms: err.union, err.propagate
//!
//! Connection errors are ROWS, not traps (D30): dialing a port nobody
//! listens on is the `refused` tag — handleable with `else` (the
//! fallback fires, the program continues) or propagated with `?` (the
//! documented process outcome: the tag on stdout, exit 1).
//! Deterministic on any host without touching a fixed port: bind
//! loopback port 0, learn the ephemeral port, close the listener,
//! then dial it. Checked-lane twins in `crates/wolf_mem/tests/net.rs`;
//! since s106 the native lanes lower the family too (c26), and this
//! file's fail-pin keeps every lane's verdict honest — the tag must
//! be `refused`, never a coarser one.

fn main() -> !int {
    let srv = net_listen("127.0.0.1:0")?
    let port = net_port(srv)?
    net_close(srv)?
    let sock = net_connect("127.0.0.1:{port}") else |_| 0
    print("handled: {sock}")
    let strict = net_connect("127.0.0.1:{port}")?
    print("unreachable: {strict}")
    0
}
