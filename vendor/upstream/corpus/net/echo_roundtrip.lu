//! check: run(exit=0, stdout="got: ping\nreply: pong")
//! phase: run
//! conforms: err.union, err.propagate
//!
//! The s39 net litmus: a TCP echo over loopback, port 0 (the OS picks
//! — no fixed ports, no external network, EVER). Deterministic
//! single-threaded ordering: a connect against a listening socket
//! completes in the backlog before accept runs (TCP semantics), so
//! the dial can precede the accept. Errors are D30 rows throughout —
//! every edge here propagates with `?`. Checked-lane twins in
//! `crates/wolf_mem/tests/net.rs`; since s106 the native lanes lower
//! the family through `wolf_rt::net`'s shims over the NetTable
//! (c26 — the crossing), so this file runs everywhere wolfgang runs.

fn main() -> !int {
    let srv = net_listen("127.0.0.1:0")?
    let port = net_port(srv)?
    let cli = net_connect("127.0.0.1:{port}")?
    net_write(cli, "ping")?
    let conn = net_accept(srv)?
    let msg = net_read(conn, 16)?
    print("got: {msg}")
    net_write(conn, "pong")?
    let reply = net_read(cli, 16)?
    print("reply: {reply}")
    net_close(cli)?
    net_close(conn)?
    net_close(srv)?
    0
}
