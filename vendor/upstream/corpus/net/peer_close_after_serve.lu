//! check: run(exit=0, stdout="deadline after peer reset: armed | reads end: closed")
//! phase: run
//! conforms: err.union, err.propagate
//!
//! wolf-lang#224 (lobo ws14): a connected client whose peer closed
//! WITHOUT draining what the client sent. lobo's serve sequence hands
//! the parsed head to `serve_request` and never reads the socket, so
//! the request bytes are still in the accepted socket's receive
//! buffer when the server closes it — and a close over unread receive
//! data is an RST close, not a FIN close. The reply (written before
//! the close) is still readable on the client; what the reset changes
//! is the client socket's option surface: on macOS `setsockopt(SO_RCVTIMEO)`
//! answers EINVAL on a reset socket (linux keeps answering 0). The
//! checked machine implemented `net_deadline` as exactly that pair of
//! setsockopts and mapped the EINVAL to the `io` row, so lobo's client
//! died at `net_deadline(cli, …)` before it read one byte of a 247-byte
//! reply, on that host only; the native tier's deadline is the
//! reactor's timer wheel and never asks the kernel. Pinned: the
//! deadline ARMS (the row is a real bug, not a platform nicety), and
//! the reads end in the ordinary `closed` row. Whether the reply
//! written before the reset is delivered first is the KERNEL's
//! (macOS and linux hand it over, Windows discards it with the reset
//! — measured on this row's first CI run), so the witness reads until
//! the row and pins only the row. Loopback, port 0, no timing
//! dependence: the reset is on the wire before the client's first
//! call.

fn main() -> !int {
    let l = net_listen("127.0.0.1:0")?
    let p = net_port(l)?
    let cli = net_connect("127.0.0.1:{p}")?
    net_write(cli, "GET / HTTP/1.1\r\nHost: x\r\nConnection: close\r\n\r\n")?
    let conn = net_accept(l)?
    // the server answers WITHOUT reading the request (lobo's shape:
    // the head was parsed elsewhere) and closes over the unread bytes
    net_write(conn, "HTTP/1.1 200 OK\r\nContent-Length: 5\r\n\r\nhello")?
    net_close(conn)?
    // #224's line: must arm, never `io`
    var armed = "io"
    net_deadline(cli, 1000) else |_| {
        armed = "raised"
    }
    if armed == "io" {
        armed = "armed"
    }
    // read until the row: the reply (if this kernel delivers it past
    // the reset) and then the reset itself, which is `closed`
    var end = "data"
    var more = true
    while more {
        let piece = net_read(cli, 4096) else |e| match e {
            closed => {
                end = "closed"
                more = false
                ""
            },
            timeout => {
                end = "timeout"
                more = false
                ""
            },
            utf8 => {
                end = "utf8"
                more = false
                ""
            },
            io => {
                end = "io"
                more = false
                ""
            },
        }
        if piece.len == 0 {
            more = false
        }
    }
    print("deadline after peer reset: {armed} | reads end: {end}")
    net_close(cli)?
    net_close(l)?
    0
}
