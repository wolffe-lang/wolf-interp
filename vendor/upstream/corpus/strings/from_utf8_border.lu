//! check: run(exit=0, stdout="wolf é 3 0 7\nREFUSED REFUSED REFUSED REFUSED REFUSED")
//! phase: run
//! conforms: str.views, mem.str.get
//!
//! s81 (wolf-lang#58) — the byte SOURCE. s77 gave the language a byte
//! VIEW (`s.bytes()`) and deliberately no way back: an unchecked
//! bytes-to-str path is the forging hole, and "every `str` is valid
//! UTF-8" has to survive CONSTRUCTION, not only narrowing. So
//! `str_from_utf8(b: List[byte]) -> str ! {utf8}` validates, and its
//! refusal is a ROW a caller handles with `else` — never a trap, never
//! undefined behaviour.
//!
//! The refusals below are UTF-8's own, one named failure mode each:
//! a lone continuation byte, a truncated sequence, an overlong form, a
//! surrogate, a scalar past U+10FFFF. An interior NUL is VALID text
//! and is accepted: a wolf `str` carries its length, so nothing
//! terminates. Until s136 the argument was `List[int]` and two more
//! rows stood here — `300` and `-1`, elements that are not bytes at
//! all; `List[byte]` (#231, D72) cannot hold either, so those two
//! refusals retired with the type that made them expressible. The
//! builder below spells its octets `as byte`.
//!
//! Round-tripping `"wolf é".bytes()` through it is the witness that the
//! view and the source agree: 7 bytes out, 7 bytes back, same string.

fn decode(bs: List[byte]) -> str {
    str_from_utf8(bs) else "REFUSED"
}

fn seq(a: int, b: int, c: int, dd: int, n: int) -> List[byte] {
    var l = List[byte]()
    if n > 0 { (mut l).push(a as byte) }
    if n > 1 { (mut l).push(b as byte) }
    if n > 2 { (mut l).push(c as byte) }
    if n > 3 { (mut l).push(dd as byte) }
    l
}

fn main() -> !int {
    // Accepted: ASCII, a two-byte scalar, an interior NUL, the empty
    // sequence, and the round trip through the s77 byte view.
    let ascii = decode(seq(119, 111, 108, 102, 4))
    let accented = decode(seq(195, 169, 0, 0, 2))
    let nul = decode(seq(119, 0, 102, 0, 3))
    let empty = decode(List[byte]())
    let round = decode("wolf é".bytes())
    print("{ascii} {accented} {nul.len} {empty.len} {round.len}")

    // Refused, and each refusal is a value, not a trap.
    let lone = decode(seq(128, 0, 0, 0, 1))
    let trunc = decode(seq(226, 130, 0, 0, 2))
    let overlong = decode(seq(192, 175, 0, 0, 2))
    let surrogate = decode(seq(237, 160, 128, 0, 3))
    let too_big = decode(seq(245, 128, 128, 128, 4))
    print("{lone} {trunc} {overlong} {surrogate} {too_big}")

    if round == "wolf é" && ascii == "wolf" && nul.len == 3 && empty.len == 0 {
        0
    } else {
        1
    }
}
