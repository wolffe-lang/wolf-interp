//! check: run(exit=0, stdout="plain 42\nspaces 7\nascii_ws 12\nuni_ws 12\nneg -13\nplus 5\nzeros 7\nzero 0\nneg_zero 0\nmax 9223372036854775807\nmin -9223372036854775808\nover row\nunder row\nhuge row\nempty row\nblank row\nword row\ninner_space row\nunderscore row\nfraction row\nexponent row\nhex row\narabic row\nlone_sign row\ntrailing row\nsum 8\nvia_fn 7 0")
//! phase: run
//! conforms: err.union, err.else, mem.str.ws, mem.str.parse, mem.str.to_int
//!
//! s142 (wolf-lang#263) — `str.to_int() -> int ! {parse}`, the
//! first non-trivial string call the book's chapter 1 makes, row for
//! row with the reference interpreter. What decides the clause is
//! not `"42"`: it is the whitespace, the sign, the leading zeros and
//! every shape that is NOT an int. s143 (wolf-lang#265) wrote the
//! clause this battery had been executing — `[mem.str.parse]` (one
//! method; the row is the lowercase mark `parse`, s142's `NotAnInt`
//! retired) and `[mem.str.to_int]` (the trim, the value, the row) —
//! and the battery cites it. The mark is not SPELLED here on purpose:
//! this file pins what is a value and what is the row on both
//! machines, and stays byte-identical under a lupin that still says
//! `NotAnInt`; `rows/to_int_parse.lu` pins the spelling.
//!
//!   the value     an optionally signed (`+`/`-`) run of ASCII digits
//!                 that fits `int`; leading zeros are digits.
//!   whitespace    the surrounding `[mem.str.ws]` run is ignored —
//!                 ASCII and the non-ASCII separators alike — so
//!                 `s.to_int()` and `s.trim().to_int()` are one value.
//!   the row       everything else is the row, never a trap: the
//!                 empty and the blank text, a word, an interior
//!                 space, `_` separators, a fraction, an exponent, a
//!                 radix prefix, a non-ASCII digit, a lone sign,
//!                 trailing letters.
//!   the magnitude a signed run of digits too large for `int` is the
//!                 row too — there is no `int` the text names, and X3
//!                 forbids a quiet wrap. r12 moved `over`/`under`/
//!                 `huge` here from `wolf_rt`'s crate tests, where
//!                 s142 had to leave them: the interpreter parsed to
//!                 `i128` and answered `9223372036854775808 : i64`,
//!                 so a witness would have pinned one side against
//!                 the other rather than pinning the language
//!                 (wolf-interp#69, fixed in lupin 0.1.28).
//!
//! The last two lines are chapter 1's own idiom (`row.to_int() else
//! 0` over a multiline literal's `lines()`) and the `?`-inside-a-fn
//! shape `grammar/else_default.lu` pinned at resolve before the
//! method existed on either compiler tier.

fn show(label: str, s: str) {
    let v = s.to_int() else 0 - 1
    if v == 0 - 1 { print("{label} row") } else { print("{label} {v}") }
}

fn parse(s: str) -> !int { s.to_int() }

fn main() -> !int {
    show("plain", "42")
    show("spaces", "  7  ")
    show("ascii_ws", "\t\n 12 \r\n")
    show("uni_ws", "\u{a0}12\u{2003}")
    show("neg", "-13")
    show("plus", "+5")
    show("zeros", "007")
    show("zero", "0")
    show("neg_zero", "-0")
    show("max", "9223372036854775807")
    show("min", "-9223372036854775808")
    show("over", "9223372036854775808")
    show("under", "-9223372036854775809")
    show("huge", "99999999999999999999")
    show("empty", "")
    show("blank", "   ")
    show("word", "four")
    show("inner_space", "4 2")
    show("underscore", "1_000")
    show("fraction", "3.5")
    show("exponent", "1e3")
    show("hex", "0x10")
    show("arabic", "\u{663}")
    show("lone_sign", "-")
    show("trailing", "12a")
    let amounts = """
        3
        four
        5
        """
    var total = 0
    for row in amounts.lines() {
        total += row.to_int() else 0
    }
    print("sum {total}")
    let a = parse("7") else 0
    let b = parse("x") else 0
    print("via_fn {a} {b}")
    0
}
