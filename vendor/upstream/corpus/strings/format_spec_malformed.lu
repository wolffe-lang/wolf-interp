//! check: fail(E0412)
//! phase: resolve
//! conforms: str.interp
//!
//! A malformed format spec is a COMPILE error at the literal (s38,
//! #28): every spec is comptime-known, so nothing malformed survives
//! to run time. Here the zero FLAG follows an explicit alignment —
//! the spec must pick zero-padding or alignment; the compiler never
//! picks silently. (`{n:0>8}` is different and legal: fill `0` plus
//! align `>` — the two-character form reads as fill+align.)

fn main() -> !int {
    let n = 42
    print("[{n:>08}]")
    0
}
