//! check: run(exit=0, stdout="hello, wolf")
//! phase: run
//! conforms: str.interp
//!
//! FORMERLY the most user-visible refusal in the language (reported
//! mid-c08): a function RETURNING an interpolated string. s40 repaid
//! it — lowering materializes the value through the region-backed
//! strbuf (`wolf_rt::str`'s design note, the c08-owed decision:
//! allocation lands in the ambient region per [mem.region.create.3]),
//! so this file now RUNS natively and is the s40 acceptance witness.
//! The checked-lane twin
//! (`crates/wolf_mem/tests/str_builtins.rs::interpolated_str_as_a_value`)
//! pins the same bytes from the reference side.

fn greet(name: str) -> str {
    "hello, {name}"
}

fn main() -> !int {
    print(greet("wolf"))
    0
}
