//! check: run(exit=0)
//! phase: run
//! conforms: mem.str.chars, mem.str.get, type.char.cast
//!
//! s120 — `chars()` (#17): code-point iteration, the third leg of the
//! boundary primitive; s121 (D58) typed it — `List[char]`, and this
//! walk survived the migration verbatim. Each element is a `char`
//! whose UTF-8 byte extent is a function of its scalar value (1/2/3/4
//! by range — `c as int` names the scalar for the arithmetic), so the
//! walk below reconstructs the byte offsets from the chars alone and
//! lands on exactly the boundaries `get` accepts — over a 1-byte `a`,
//! the 2-byte `é`, the 3-byte `中`, the 4-byte `🐺`. That identity
//! ([mem.str.chars]) is what makes a byte-offset scanner writable in
//! library code. Lupin 0.1.14 refuses `chars()` by name
//! (`unsupported`) and its lexer still refuses `'` outright
//! (fail(E0101), measured), so this file is wolfc-lane evidence until
//! the interpreter catches up (the named wolf-interp follow-on from
//! the s121 closeout).

fn width(c: char) -> int {
    let n = c as int
    if n < 128 {
        1
    } else if n < 2048 {
        2
    } else if n < 65536 {
        3
    } else {
        4
    }
}

fn main() -> !int {
    let s = "aé中🐺"
    let cs = s.chars()
    let scalars_ok = cs.len == 4 && cs[0] == 'a' && cs[1] == 'é' && cs[2] == '中' && cs[3] == '🐺'
    // The typed elements still name their code points ([type.char.cast]
    // — the total direction).
    let codes_ok = cs[0] as int == 97 &&
        cs[1] as int == 233 &&
        cs[2] as int == 20013 &&
        cs[3] as int == 128058
    // The width walk: advance a byte cursor by each char's extent;
    // every stop is a boundary `get` accepts, and the cursor ends at
    // the byte length.
    var off = 0
    var hits = 0
    for c in cs {
        let w = width(c)
        let piece = s.get(off..off + w) else "?"
        if piece != "?" {
            hits = hits + 1
        }
        off = off + w
    }
    let walk_ok = off == s.len && hits == 4 && s.len == 10
    // The edges: empty yields nothing; ASCII is one char per byte.
    let none = "".chars()
    let ascii = "wolf".chars()
    let edges_ok = none.len == 0 && ascii.len == 4 && ascii[0] == 'w' && ascii[3] == 'f'
    if scalars_ok && codes_ok && walk_ok && edges_ok {
        0
    } else {
        1
    }
}
