//! check: fail(E0402)
//! phase: resolve
//! conforms: mem.str.ws
//!
//! s175 (wolf-interp#125) — `trim` takes no argument: the separator
//! set is `[mem.str.ws]`'s frozen `White_Space` and nothing else, so a
//! cutset is the arity mismatch E0402 by name. lupin 0.1.37 accepted
//! `s.trim(".,!?")` and stripped those characters — an extension no
//! clause describes, invisible to the differ because the compiler's
//! arm never compiled it. The loop is the spelling for a cutset.

fn main() -> !int {
    let w = "..hi!?"
    print("[{w.trim(".,!?")}]")
    0
}
