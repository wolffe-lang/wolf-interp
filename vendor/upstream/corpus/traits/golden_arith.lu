//! check: fail(E0501)
//! phase: resolve
//! conforms: generics.golden.def-site
//!
//! Arithmetic on a bare archetype: `+` on a type parameter dispatches
//! through `Add.add` when the bound names `Add` (`[type.trait.op]`,
//! s155), and this bound names nothing — so the definition is the
//! error site, and the note says what to add: `T: Add`.

fn sum[T](a: T, b: T) -> T {
    a + b
}

fn main() -> !int {
    0
}
