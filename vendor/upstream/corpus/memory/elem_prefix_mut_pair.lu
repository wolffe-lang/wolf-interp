//! check: fail(E1002)
//! phase: typecheck
//! conforms: mem.model.place.elem, mem.tier0.excl.1, mem.model.path.disjoint
//!
//! eg02 (EGC's EG2) — a path and its prefix still conflict:
//! `add2(mut g[0], mut g[0][1])`. `g[0]` contains `g[0][1]`, so the two
//! claims overlap whatever the clause says about distinct literals (item
//! 2's last sentence, `[mem.model.path.disjoint]`). E1002 on every
//! wolfgang lane, before and after EG2; lupin 0.1.41 traps `exclusivity`.

fn add2(mut a: List[int], mut b: int) {
    (mut a).push(b)
    b = 0
}

fn main() -> !int {
    var g = List[List[int]]()
    (mut g).push([1, 2])
    add2(mut g[0], mut g[0][1])     // ERROR E1002: `g[0][1]` is inside `g[0]`
    print("{g[0].len}")
    0
}
