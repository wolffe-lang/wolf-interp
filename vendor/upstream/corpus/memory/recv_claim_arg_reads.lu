//! check: run(exit=0, stdout="5 2 5 5 2 3 3 5 3 3 2 10 5\n")
//! phase: run
//! conforms: mem.tier0.excl.4, mem.tier0.excl.3, mem.model.order, mem.model.place.elem
//!
//! s192 (wolf-lang#487) — what a `mut` receiver's own arguments may
//! still do, each seeing the value from before the call (a receiver's
//! claim was always two-phase, `[mem.tier0.excl.4]`): a header read
//! (`(mut xs).push(xs.len)`), a whole read one call down, a block that
//! writes only its own local, bu12's sibling-field read
//! (`(mut out.class_off).push(out.bytes.len)`, boreutils `tr.lu:528`),
//! a write to a sibling field, reads around an element receiver, a
//! write to a different literal element, a receiver written AFTER the
//! call, and a read of a view-set receiver's own field. Each ran before
//! s192 with these bytes on every machine, lupin 0.1.42 included, and
//! still does.

struct Out {
    bytes: List[int],
    class_off: List[int],
}

struct V {
    x: int,
    y: int,
    z: int,
}

impl V {
    fn set_x(mut self.{x}, n: int) {
        self.x = self.x + n
    }
}

fn total(ys: List[int]) -> int {
    var t = 0
    for y in ys {
        t = t + y
    }
    t
}

fn main() -> !int {
    var xs = [1, 2]
    (mut xs).push(xs.len)
    (mut xs).push(total(xs))
    (mut xs).push({
        var t = xs.len
        t = t + xs[0]
        t
    })
    var out = Out { bytes: [7, 8], class_off: List[int]() }
    (mut out.class_off).push(out.bytes.len)
    (mut out.class_off).push({
        out.bytes = [4, 4, 4]
        out.bytes.len
    })
    var ys = [[1], [2, 3]]
    (mut ys[0]).push(ys[1].len + ys[0][0] + ys.len)
    (mut ys[0]).push({
        ys[1] = [7, 7, 7]
        ys[1].len
    })
    var zs = [1, 2]
    (mut zs).push(3)
    zs = [9]
    (mut zs).push(zs[0] + 1)
    var p = V { x: 1, y: 2, z: 3 }
    (mut p).set_x(p.x + p.z)
    print(
        "{xs.len} {xs[2]} {xs[3]} {xs[4]} {out.class_off[0]} {out.class_off[1]} {out.bytes.len} {ys[0][1]} {ys[0][2]} {ys[1].len} {zs.len} {zs[1]} {p.x}",
    )
    0
}
