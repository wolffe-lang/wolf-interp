//! check: run(exit=0)
//! phase: mem
//! conforms: mem.region.multiopen, mem.region.intra.1
//! FLAGGED FOR is07: interleaved building into two pool regions; each
//! handle stays valid for its own pool.

struct Node { value: int }

fn main() -> !int {
    var sum = 0
    region a: pool(Node) {
        region b: pool(Node) {
            var pa = Pool[Node]()
            var pb = Pool[Node]()
            let ha = (mut pa).reserve()
            let hb = (mut pb).reserve()
            in a { (mut pa).init(ha, Node { value: 10 }) }
            in b { (mut pb).init(hb, Node { value: 20 }) }
            sum = pa[ha].value + pb[hb].value
        }
    }
    if sum == 30 { 0 } else { 1 }
}
