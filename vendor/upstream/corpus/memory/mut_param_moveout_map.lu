//! check: fail(E1001)
//! phase: typecheck
//! conforms: mem.tier0.mode.mut, mem.tier0.move.1, mem.model.place.elem
//!
//! s184 (wolf-lang#464) — a map value of a `mut` parameter is a place
//! under it, so it too is initialized at every return: `f` reads the
//! value at `m[k]` out (a non-`Copy` read moves) and returns without
//! storing it back. E1001 at the read.
//!
//! Through 0.2.17 and trunk `a201c518` it compiled with only W1002, and
//! checked, native and release printed `2`: the caller's `m["a"]`
//! named the buffer `f` read out and pushed to. lupin 0.1.40 prints `1`
//! (its map read copies, wolffe-lang/wolf-interp#144).

fn f(mut m: Map[str, List[int]], k: str) {
    var v = m[k] else List[int]()   // ERROR E1001: `m[k]` returns to the caller moved-out
    (mut v).push(9)
}

fn main() -> !int {
    var m = Map[str, List[int]]()
    m["a"] = [1]
    f(mut m, "a")
    let a = m["a"] else List[int]()
    print("{a.len}")
    0
}
