fn apply(f: fn(int) -> int, x: int) -> int { f(x) }

fn main() -> !int {
    let add3 = fn(x: int) { x + 3 }
    let got = apply(add3, 4)
    let sink = alpha(5) % 10 + beta(4) % 10
    print("{got}")
    if got == 7 && sink >= 0 { 0 } else { 1 }
}
