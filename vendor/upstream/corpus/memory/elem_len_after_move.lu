//! check: run(exit=0, stdout="1 2\n")
//! phase: run
//! conforms: mem.model.place.elem, mem.tier0.move.2
//!
//! eg01 (EGC's EG1) — `[mem.model.place.elem]` item 1(c): `move xs[0]`,
//! then a read of `xs.len`. An element and a member of its container
//! are distinct steps — the header is not an element (a `List` carries
//! one field-shaped member, `len`). `1 2` on checked, native, release
//! and lupin 0.1.40; E1001 on both wolfgang lanes through 0.2.17.

fn main() -> !int {
    var xs = List[List[int]]()
    (mut xs).push([1])
    (mut xs).push([2, 3])
    let a = move xs[0]
    print("{a.len} {xs.len}")
    0
}
