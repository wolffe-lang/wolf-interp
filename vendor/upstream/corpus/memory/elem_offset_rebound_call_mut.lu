//! check: fail(E1002)
//! phase: typecheck
//! conforms: mem.model.place.elem, mem.tier0.excl.1
//!
//! eg03 — `[mem.model.place.elem]` item 4, WHERE R1 FAILS: `i` is
//! written between the two claims by a nested call, `back(mut i)`, so
//! `xs[i + 1]` names index 1 again, the element `xs[i]` claimed. The
//! two stay one place: E1002 on every wolfgang lane. lupin 0.1.42 traps
//! `exclusivity`.

fn back(mut i: int) -> int {
    i = i - 1
    0
}

fn add3(mut a: int, n: int, mut b: int) {
    a = a + 1
    b = b + 10 + n
}

fn main() -> !int {
    var xs = [1, 2, 3]
    var i = 1
    add3(mut xs[i], back(mut i), mut xs[i + 1])  // ERROR E1002: i is written between the claims
    print("{xs[0]} {xs[1]} {i}")
    0
}
