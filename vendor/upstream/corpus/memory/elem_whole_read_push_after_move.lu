//!
//! s185 (wolffe-lang/wolf-interp#149, ruled 2026-09-30) — the whole-read
//! twin of `elem_header_methods_after_move.lu`: `push` is not a header
//! read, it takes the whole container, and the whole container is a
//! prefix of the moved `xs[0]`. E1001 on every wolfgang lane; lupin
//! 0.1.40 and 0.1.41 run it (`1 3`); the ruled lupin answer is the
//! `use-after-move` trap (is60).

fn main() -> !int {
    var xs = [[1], [2]]
    let a = move xs[0]
    (mut xs).push([3])
    print("{a.len} {xs.len}")
    0
}
