//! check: run(exit=0)
//! phase: mem
//! conforms: mem.prov.state, mem.prov.tag
//! The two-phase shape Tree Borrows tolerates (and SB rejects): the
//! receiver's mut tag is Reserved while the argument reads the same
//! container, activating only at the write.

fn main() -> !int {
    var xs = List[int]()
    (mut xs).push(10)
    (mut xs).push(xs.len)          // read xs while its mut receiver tag
                                   // is Reserved [mem.prov.state]
    if xs[1] == 1 { 0 } else { 1 }
}
