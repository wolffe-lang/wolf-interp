//! check: fail(E1001)
//! phase: typecheck
//! conforms: mem.model.place.elem, mem.tier0.move.2, mem.tier0.move.4
//!
//! eg01 — `[mem.model.place.elem]` item 4's R3 fails when the local is
//! assigned between: `var t = move xs[i]` with `i = 0`, then `i = 1`,
//! then `xs[i] = take t`. The store and the move spell `xs[i]` alike but
//! `i` changed, so the store is not provably the moved element and
//! revives nothing: the moved `xs[i]` may be any element, and both
//! reads (`xs[0]`, `xs[1]`) are E1001. The twin of
//! `elem_same_index_revive.lu`, where `i` is unassigned between.
//!
//! Through 0.2.17 it compiled (any index store revived the collapsed
//! element, wolf-lang#460): the checked machine trapped
//! `use-after-move` at the read of `xs[0]`, native and release printed
//! `1 1 2`. lupin 0.1.40 prints `1 1 2` too — its index read ignores
//! the moved mark (wolffe-lang/wolf-interp#141).

fn main() -> !int {
    var xs = List[List[int]]()
    (mut xs).push([1])
    (mut xs).push([2, 3])
    var i = 0
    var t = move xs[i]
    i = 1
    xs[i] = take t
    print("{xs[0].len} {xs[1].len} {i + 1}")   // ERROR E1001: `i` changed after `xs[i]` moved (both reads)
    0
}
