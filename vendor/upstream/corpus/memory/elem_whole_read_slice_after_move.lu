//!
//! s185 (wolffe-lang/wolf-interp#149, ruled 2026-09-30) — the whole-read
//! twin for a slice beside the moved element: `xs[1..3]` reads the
//! whole container, a prefix of the moved `xs[0]`. E1001 on every
//! wolfgang lane; lupin 0.1.40 and 0.1.41 run it (`1 2`); the ruled
//! lupin answer is the `use-after-move` trap (is60).

fn main() -> !int {
    var xs = [[1], [2, 3], [4]]
    let a = move xs[0]
    let s = xs[1..3]
    print("{a.len} {s.len}")
    0
}
