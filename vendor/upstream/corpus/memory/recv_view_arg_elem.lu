//! check: run(exit=0, stdout="10 9 6\n")
//! phase: run
//! conforms: mem.tier0.excl.3, mem.tier0.excl.4, mem.tier0.mode.mut, mem.model.order
//!
//! s193 (wolf-lang#494) — an ELEMENT receiver with a view set
//! (`(mut ps[0]).set_x(..)`), the argument writing that element's
//! field outside the view. native and release lend the element's
//! address (no spill, no write-back), so this already printed
//! `10 9 6` on every wolfgang lane before s193; it pins that the
//! element form keeps doing so. lupin 0.1.42 prints `10 3 6`.

struct V {
    x: int,
    y: int,
    z: int,
}

impl V {
    fn set_x(mut self.{x}, n: int) {
        self.x = self.x + n
    }
}

fn main() -> !int {
    var ps = [V { x: 1, y: 2, z: 3 }, V { x: 4, y: 5, z: 6 }]
    (mut ps[0]).set_x({
        ps[0].z = 9
        ps[0].z
    })
    print("{ps[0].x} {ps[0].z} {ps[1].z}")
    0
}
