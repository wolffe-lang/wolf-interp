fn main() -> !int {
    var owned = List[int]()
    (mut owned).push(1)
    (mut owned).push(2)
    (mut owned).push(3)
    let cut = owned[0..2]
    print("{cut.len} {cut[0]} {cut[1]}")
    0
}
