//! check: run(exit=0, stdout="1 7 0 5\n")
//! phase: run
//! conforms: mem.unsafe.raw.1, mem.unsafe.raw.5, abi.layout.c
//!
//! s213 (wolf-lang#577): a store to a field of a raw element,
//! `p[0].b = 7`, writes the field's bytes in place at its
//! `#[repr(c)]` offset (`[mem.unsafe.raw.5]`) and leaves the other
//! field alone — the issue's witness, with the whole-struct setup store
//! spelled field by field (a whole-aggregate raw store is a separate
//! gap on the checked machine). At trunk 294d626d every compiling
//! machine refused `p[0].b = 7` ("assignment through this place
//! shape"); lupin refused it as no place.

import c "stdlib.h"

#[repr(c)]
struct Pair {
    a: u64,
    b: u64,
}

fn main() -> int {
    // # Safety: 32 zeroed bytes from calloc, two Pairs; freed once.
    unsafe {
        let p = c.calloc(2, 16) as *Pair
        p[0].a = 1
        p[0].b = 2
        p[0].b = 7
        p[1].b = 5
        print("{p[0].a as int} {p[0].b as int} {p[1].a as int} {p[1].b as int}")
        c.free(p as *u8)
    }
    0
}
