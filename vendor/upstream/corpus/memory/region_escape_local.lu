//! check: fail(E1010)
//! phase: typecheck
//! conforms: mem.region.intra.2
//! A region dies as a unit: a scratch-region value still reachable
//! from an outer binding when the region is freed wholesale. The
//! checker speaks in the allocation, the escape, and the free — never
//! lifetimes. Dynamically this is a region-fault after the free.

struct Node { value: int }

fn main() -> !int {
    var keep = Node { value: 0 }
    region tmp {
        keep = Node { value: 7 }   // ERROR E1010: outlives tmp's free
    }
    if keep.value == 7 { 0 } else { 1 }
}
