//! check: fail(E1002)
//! phase: typecheck
//! conforms: mem.model.place.elem, mem.tier0.excl.1
//!
//! eg03 — `[mem.model.place.elem]` item 4, WHERE R2 FAILS: a `for`
//! binding is assignable, and this body assigns it (`i = 0`), so `i`
//! no longer ranges over `1..3` and `xs[i]` is `xs[0]`. R2 holds only
//! for an index the body never writes: E1002 on every wolfgang lane.
//! lupin 0.1.42 traps `exclusivity`.

fn add2(mut a: int, mut b: int) {
    a = a + 1
    b = b + 10
}

fn main() -> !int {
    var xs = [1, 2, 3]
    for i in 1..3 {
        i = 0
        add2(mut xs[0], mut xs[i])  // ERROR E1002: the loop index is written in the body
    }
    print("{xs[0]} {xs[1]} {xs[2]}")
    0
}
