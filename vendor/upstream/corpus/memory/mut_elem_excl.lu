//! check: run(exit=0, stdout="2\n")
//! phase: run
//! conforms: mem.tier0.excl.1, mem.model.place.elem, mem.model.path.disjoint
//!
//! s168 — the first leg of the exclusivity story an element lend
//! rests on. Through 0.2.18 `[mem.model.place]` collapsed EVERY element
//! of a container to one opaque projection under a claim, so `xs[0]`
//! and `xs[1]` were the same place and the second claim was E1002 on
//! both lanes.
//!
//! eg02 (EGC's EG2) lifts it: `[mem.model.place.elem]` item 1(a) — two
//! integer-literal indices whose values differ are distinct places, for
//! claims as for moves. The callee holds two addresses into one buffer
//! that can never be the same element, and neither parameter can reach
//! the buffer's header. `2` on checked, native, release and lupin
//! 0.1.41. `elem_same_const_mut.lu` keeps the same literal twice
//! refused; `elem_dyn_mut_pair.lu` two run-time indices.

fn add2(mut a: int, mut b: int) {
    a = a + 1
    b = b + 1
}

fn main() -> !int {
    var xs = [1, 2, 3]
    add2(mut xs[0], mut xs[1])
    print("{xs[0]}")
    0
}
