    var xs = [1, 2, 3]
    var i = 0
    var j = 1
    add2(mut xs[i], mut xs[j])     // ERROR E1002: `xs[i]` and `xs[j]` are one place
    print("{xs[0]} {xs[1]}")
    0
}
