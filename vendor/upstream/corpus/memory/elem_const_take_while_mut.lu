//! check: run(exit=0, stdout="2 2\n")
//! phase: run
//! conforms: mem.model.place.elem, mem.tier0.excl.1, mem.tier0.mode.take
//!
//! eg02 (EGC's EG2) — `mut` against `take` per element: `put(mut xs[0],
//! take xs[1])` moves `xs[1]` into the call while `xs[0]` goes `mut` in
//! it. Distinct literals: `2 2` on checked, native, release and lupin
//! 0.1.41; E1002 on every wolfgang lane through 0.2.18.

fn put(mut a: List[int], take b: List[int]) {
    (mut a).push(b.len)
}

fn main() -> !int {
    var xs = List[List[int]]()
    (mut xs).push([1])
    (mut xs).push([2, 3])
    put(mut xs[0], take xs[1])
    print("{xs[0].len} {xs[0][1]}")
    0
}
