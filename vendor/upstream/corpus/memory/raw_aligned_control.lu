//! check: run(exit=0, stdout="aligned 4096 513 77 200 -2\n")
//! phase: run
//! conforms: mem.unsafe.raw.4, mem.unsafe.raw.1
//!
//! s209 (ruling #36 = A): the near-miss twin of the six
//! `raw_ub_misaligned_*` rows. Every access sits at a multiple of its
//! pointee's alignment — a `*u64` at offset 8, a `*u16` at 6, a `*u32`
//! at 12, an `*i32` at 4 through `*q` — and a `*u8` at the odd
//! offset 5 needs none, so row L4 is not reached and every machine
//! answers the same.

import c "stdlib.h"

fn main() -> int {
    // # Safety: 32 zeroed bytes from calloc; every access is inside
    // them at its pointee's alignment; freed once.
    unsafe {
        let p = c.calloc(1, 32) as *u64
        let q = p.with_addr(p.addr() + 8)
        q[0] = 4096
        let a = q[0] as int
        let h = p as *u16
        let r = h.with_addr(h.addr() + 6)
        r[0] = 513
        let b = r[0] as int
        let w = p as *u32
        w[3] = 77
        let d = w[3] as int
        let one = (p as *u8).with_addr(p.addr() + 5)
        one[0] = 200
        let e = one[0] as int
        let s = (p as *i32).with_addr(p.addr() + 4)
        *s = -2
        let f = *s as int
        c.free(p as *u8)
        print("aligned {a} {b} {d} {e} {f}")
        0
    }
}
