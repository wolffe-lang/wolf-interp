//! check: fail(E1002)
//! phase: typecheck
//! conforms: mem.model.place.elem, mem.tier0.excl.1
//!
//! eg03 — `[mem.model.place.elem]` item 4, WHERE R2 FAILS: the range
//! bound is a local (`1..n`), not a literal, so the proof cannot read
//! the range and `xs[i]` stays one place with `xs[0]`: E1002 on every
//! wolfgang lane. lupin 0.1.42 runs it (`3 12 13`, because `n` is 3) —
//! a conservatism row.

fn add2(mut a: int, mut b: int) {
    a = a + 1
    b = b + 10
}

fn main() -> !int {
    var xs = [1, 2, 3]
    var n = 3
    for i in 1..n {
        add2(mut xs[0], mut xs[i])  // ERROR E1002: the range is not literal
    }
    print("{xs[0]} {xs[1]} {xs[2]}")
    0
}
