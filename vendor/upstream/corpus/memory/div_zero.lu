//! check: run(exit=trap(div-zero))
//! phase: resolve
//! conforms: mem.ub.defined
//! Division by zero is a deterministic trap, not UB — the optimizer's
//! recovery is range-based check elision, never nasal demons.

fn main() -> !int {
    var d = 0
    let x = 10 / d                 // TRAP div-zero
    x
}
