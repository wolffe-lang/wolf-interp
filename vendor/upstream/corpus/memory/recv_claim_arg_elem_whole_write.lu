//! check: fail(E1002)
//! phase: typecheck
//! conforms: mem.tier0.excl.4, mem.tier0.excl.1, mem.tier0.mode.mut, mem.model.order
//!
//! s192 (wolf-lang#487) — the container of an element receiver
//! replaced whole inside the call's argument: a write of a prefix of
//! the claimed place. Through 0.2.19 every wolfgang lane printed `1 1`;
//! lupin 0.1.42 runs it and prints `1 2`. E1002 now.

fn main() -> !int {
    var xs = [[1], [2]]
    (mut xs[0]).push({
        xs = [[7]]  // ERROR E1002: xs written inside the receiver claim on xs[0]
        5
    })
    print("{xs.len} {xs[0].len}")
    0
}
