//! check: run(exit=0, stdout="taken 3\nkept 9\n")
//! phase: run
//! conforms: abi.native.enum, mem.tier0.mode.take
//!
//! s257 — a `take` of a payload through a match: `drain` owns `v`, the
//! `List[int]` bound by the arm moves into `consume` through the union
//! slot it shares with an `int`; the scalar arm is a plain read.

enum V {
    N(int),
    L(List[int]),
}

fn consume(take xs: List[int]) -> int {
    xs.len
}

fn drain(take v: V) -> str {
    match v {
        L(xs) => {
            let n = consume(take xs)
            "taken {n}"
        },
        N(n) => "kept {n}",
    }
}

fn main() -> !int {
    let a = drain(take V.L([1, 2, 3]))
    print("{a}")
    let b = drain(take V.N(9))
    print("{b}")
    0
}
