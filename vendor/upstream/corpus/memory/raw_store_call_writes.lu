//! check: run(exit=0, stdout="9 9 4\n")
//! phase: run
//! conforms: mem.unsafe.raw.1, mem.unsafe.scope
//!
//! s214 (wolf-lang#598, P0): a raw pointer carries no aliasing
//! assumption (`[mem.unsafe.raw.1]`), so a callee handed the pointer
//! may write through it and the caller reads the write. Module state,
//! `extern "c" let` storage and a C allocation all ride the same raw
//! region, and #598 was that region's, not module state's: at wolf
//! 0.2.24 (294d626d) native and release printed `1 1 1` here (the
//! caller's store forwarded across `poke`, the first read reused after
//! it). The checked machine and lupin 0.1.47 printed what this row says.

import c "stdlib.h"

fn poke(p: *i64, v: i64) {
    // # Safety: p addresses one live i64.
    unsafe {
        p[0] = v
    }
}

fn main() -> int {
    // # Safety: one zeroed i64 from calloc; freed once.
    unsafe {
        let p = c.calloc(1, 8) as *i64
        p[0] = 1
        poke(p, 9)
        let a = p[0]
        let x = p[0]
        poke(p, 4)
        let y = p[0]
        print("{a} {x} {y}")
        c.free(p as *u8)
    }
    0
}
