//! check: fail(E1001)
//! phase: typecheck
//! conforms: mem.model.place.elem, mem.tier0.move.2, mem.tier0.move.4
//!
//! eg01 (wolf-lang#460) — `[mem.model.place.elem]` item 3, the `Copy`
//! twin through a run-time index: `let a = move xs[0]; xs[i] = 9` with
//! `i = 1`, then a read of `xs[0]`. Only a store the rules relate to
//! the moved element revives it; `xs[i]` and `xs[0]` are unrelated
//! spellings, so `xs[0]` stays moved (E1001).
//!
//! Before eg01 every machine printed `1 1 9` (B126 on checked,
//! wolffe-lang/wolf-interp#141 on lupin 0.1.40).

fn main() -> !int {
    var xs = [1, 2]
    var i = 1
    let a = move xs[0]
    xs[i] = 9
    print("{a} {xs[0]} {xs[1]}")   // ERROR E1001: `xs[i] = 9` is not provably `xs[0]`
    0
}
