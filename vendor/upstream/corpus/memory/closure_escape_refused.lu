//! check: run(exit=0)
//! phase: wir
//! conforms: mem.model.value, mem.tier0.borrow.1, abi.native.closure, type.fn.value
//! s105 (c25) wrote this as the escape position that REMAINED refused,
//! by name — a CAPTURING closure crossing a call boundary, when the
//! fn-value ABI was one word and the pair was two, its env borrowing
//! places of the creating frame. s150 (wolf-lang#300) opened it: a fn
//! value is a pointer to a callable record, a capturing closure's
//! record copies its captures where it is written and lives in the
//! ambient region (`[abi.native.closure]`, `[type.fn.value]`), so
//! `apply(g, 1)` hands the callee the same one word a named function
//! would. The name is kept for the history it carries; both machines
//! now run it to `11`.

fn apply(f: fn(int) -> int, x: int) -> int { f(x) }

fn main() -> !int {
    let base = 10
    let g = fn(x: int) { x + base }
    if apply(g, 1) == 11 { 0 } else { 1 }
}
