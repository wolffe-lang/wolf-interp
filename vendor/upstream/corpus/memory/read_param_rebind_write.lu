//! check: fail(E1014)
//! phase: typecheck
//! conforms: mem.tier0.mode.read
//! s165 (wolf-lang#366) — the write E1014 refuses on `b` reached it
//! through a rebinding at v0.2.14: `var c = b` then `(mut c).push(9)`
//! grew the caller's list (`n=4 xs=4`, native and checked). `c` is the
//! caller's value under a second name, so a write or a `mut` lend
//! through it is the write through `b`. A whole reassignment of `c`
//! writes nothing of the caller's and stays legal
//! (`read_param_move_legal.lu`). lupin runs this clean (`n=4 xs=3`).

fn f(b: List[int]) -> int {
    var c = b
    (mut c).push(9)                // ERROR E1014: a write to `b`'s value
    c.len
}

fn main() -> !int {
    var xs = List[int]()
    (mut xs).push(1)
    (mut xs).push(2)
    (mut xs).push(3)
    let n = f(xs)
    print("n={n} xs={xs.len}")
    0
}
