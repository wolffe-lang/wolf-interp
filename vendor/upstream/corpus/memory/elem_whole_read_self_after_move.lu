//! check: fail(E1001)
//! phase: typecheck
//! conforms: mem.model.place.elem, mem.tier0.move.2
//!
//! s185 (wolffe-lang/wolf-interp#149, ruled 2026-09-30) — the whole-read
//! twin for an impl method's `self`: `p.why()` lends all of `p`, a
//! prefix of the moved `p.x`, whatever the body reads. E1001 on every
//! wolfgang lane; lupin 0.1.40 and 0.1.41 run it (`1 2`); the ruled
//! lupin answer is the `use-after-move` trap (is60).

struct P { x: List[int], y: int }

impl P {
    fn why(self) -> int {
        self.y
    }
}

fn main() -> !int {
    var p = P { x: [1], y: 2 }
    let a = move p.x
    print("{a.len} {p.why()}")
    0
}
