//! check: fail(E1010)
//! phase: typecheck
//! conforms: mem.region.escape, mem.str.view
//!
//! s207 (wolf-lang#540) — a `split(",")` piece, bound and kept by a
//! `break`, returned out of its region. E1010; ran to `[regions]`
//! before s207.

fn build() -> str {
    region scratch {
        let s = "re" + "gions,here"
        var first = ""
        for p in s.split(",") {
            first = p
            break
        }
        first
    }
}

fn main() -> !int {
    print("[{build()}]")
    0
}
