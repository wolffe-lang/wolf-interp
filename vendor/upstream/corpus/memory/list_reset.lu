//! check: run(exit=0, stdout="5 0 3 10 11 12 2 b2 true\n")
//! phase: run
//! conforms: type.list.reset, mem.region.account.1
//!
//! s255 (wolf-lang#821; `[type.list.reset]`): `reset()` empties a list
//! and KEEPS its buffer — the length goes to 0, the next pushes reuse
//! the storage in the list's own region, and no allocation is made by
//! the reset itself on any machine. `clear()` empties too and says
//! nothing of the buffer (the implementation's). A `List[str]` reset
//! and refilled holds the new strings; the ledger of a region holding a
//! reset list does not move at the reset (`[mem.region.account.1]`: it
//! only ever rises, and a reset charges nothing).

fn main() {
    var xs = List[int]()
    var i = 0
    while i < 5 {
        (mut xs).push(i)
        i += 1
    }
    let len_before = xs.len
    (mut xs).reset()
    let len_after = xs.len
    (mut xs).push(10)
    (mut xs).push(11)
    (mut xs).push(12)
    var names = List[str]()
    (mut names).push("a1")
    (mut names).push("a2")
    (mut names).push("a3")
    (mut names).reset()
    (mut names).push("b1")
    (mut names).push("b2")
    var flat = true
    region r {
        var zs = List[int]()
        var k = 0
        while k < 100 {
            (mut zs).push(k)
            k += 1
        }
        let a = region_bytes(r)
        (mut zs).reset()
        let b = region_bytes(r)
        flat = a == b && zs.len == 0
    }
    print("{len_before} {len_after} {xs.len} {xs[0]} {xs[1]} {xs[2]} {names.len} {names[1]} {flat}")
}
