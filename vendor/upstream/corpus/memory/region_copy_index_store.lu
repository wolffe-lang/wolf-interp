//! check: fail(E1010)
//! phase: typecheck
//! conforms: mem.region.escape, mem.region.edge.elem, mem.tier0.move.3
//!
//! s227 (wolf-lang#660's door): a plain index store COPIES the element
//! in (`[mem.region.edge.elem]`), and the copy shares its `str`.
//! Trunk a027b643 built it and read freed bytes on native and release
//! (`ZZZZZZZZZZZZZZZZZZZZZ`, the chunk `other` reused), stale ones on the
//! checked machine; lupin traps `region-fault`.

struct Doc {
    title: str,
    n: int,
}

fn main() -> !int {
    let st = region()
    in st {
        let seq0 = 0
        var ds = List[Doc]()
        (mut ds).push(Doc { title: "", n: 0 })
        region pass {
            let s = "built in pass, {seq0} uses"
            let d = Doc { title: s, n: 1 }
            in st {
                ds[0] = d
            }
        }
        region other {
            let z = "ZZZZZZZZZZZZZZZZZZZZZZZZZ{seq0}ZZ"
            print("{z.len}")
        }
        print("{ds[0].title}")
    }
    0
}
