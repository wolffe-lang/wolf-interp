//! check: fail(E1001)
//! phase: typecheck
//! conforms: mem.model.place.elem, mem.tier0.move.2
//!
//! s185 (wolffe-lang/wolf-interp#149, ruled 2026-09-30) — a header read
//! is a builtin container's `len`, `count` or `is_empty`, not a method
//! NAME: an impl method spelled `count` or `is_empty` takes the whole
//! `self`, a prefix of the moved `p.x`. E1001 on every wolfgang lane;
//! lupin 0.1.40 and 0.1.41 run it (`1 2 false`); the ruled lupin answer
//! is the `use-after-move` trap (is60).

struct P { x: List[int], y: int }

impl P {
    fn count(self) -> int {
        self.y
    }

    fn is_empty(self) -> bool {
        self.y == 0
    }
}

fn main() -> !int {
    var p = P { x: [1], y: 2 }
    let a = move p.x
    print("{a.len} {p.count()} {p.is_empty()}")
    0
}
