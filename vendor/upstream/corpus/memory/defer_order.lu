//! check: run(exit=0, stdout="body first second")
//! phase: mem
//! conforms: mem.shared.drop.1
//! Scope-exit effects run LIFO: defers (and destructors, which share the
//! scope-exit point) unwind in reverse registration order.

fn main() -> !int {
    defer print_raw(" second")
    defer print_raw(" first")
    print_raw("body")
    0
}
