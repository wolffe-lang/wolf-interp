//! check: fail(E1001)
//! phase: typecheck
//! conforms: mem.tier0.move.2
//!
//! s130 (#179) — the ARM-boundary move ruling, pinned. A `let` binder
//! destructures field-wise (`struct_destructure_partial_live`: the
//! unmatched field stays readable), but a match ARM takes the WHOLE
//! scrutinee: binding `a` below moves all of `h`, and the later read
//! of `h.b.n` — the field no arm touched — is use-after-move. The
//! spec's letter grants field-wise moves to binders through
//! `[mem.tier0.move.1]`'s initialization reading; no clause extends
//! that to arms, so s130 KEEPS the whole-scrutinee letter rather than
//! inventing finer-grained arm semantics without one (the diagnostic's
//! own `copy` suggestion is the sanctioned idiom). If a partial-move
//! clause for arms is ever ruled, this pin flips in that commit.

struct Inner {
    n: int,
}

struct Holder {
    a: Inner,
    b: Inner,
}

fn main() -> !int {
    let h = Holder { a: Inner { n: 1 }, b: Inner { n: 2 } }
    let r = match h {
        Holder { a, .. } => a.n,
    }
    let k = h.b.n
    if r + k != 3 { return 1 }
    0
}
