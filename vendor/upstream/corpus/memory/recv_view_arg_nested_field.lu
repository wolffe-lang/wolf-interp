//! check: run(exit=0, stdout="10 9 3\n")
//! phase: run
//! conforms: mem.tier0.excl.3, mem.tier0.excl.4, mem.tier0.mode.mut, mem.model.order
//!
//! s193 (wolf-lang#494) — a NESTED struct field outside the view set
//! (`p.w.a`) written in the argument. It stands, and its sibling
//! `p.w.b` is untouched. Through s192 native and release printed
//! `10 2 3`; lupin 0.1.42 prints `10 2 3`.

struct W {
    a: int,
    b: int,
}

struct V {
    x: int,
    w: W,
}

impl V {
    fn set_x(mut self.{x}, n: int) {
        self.x = self.x + n
    }
}

fn main() -> !int {
    var p = V { x: 1, w: W { a: 2, b: 3 } }
    (mut p).set_x({
        p.w.a = 9
        p.w.a
    })
    print("{p.x} {p.w.a} {p.w.b}")
    0
}
