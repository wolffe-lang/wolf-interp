//! check: run(exit=0, stdout="1 1 2\n")
//! phase: run
//! conforms: mem.region.edge.elem
//!
//! s156 (#333): a `[K, V]`-generic `set` — the single most ordinary
//! function a keyed container has — beside its `List` twin. `m[k] = v`
//! was refused ("this stores a value from `v`'s region into `m`'s
//! region" — the code is pinned by `region_conflict_params.lu`) and
//! `(mut xs).push(v)` was not, because `push`'s value
//! parameter is a `read` and a read is a lend, so nothing ever told
//! the region solver the value lands inside the receiver. The refusal
//! took the WHOLE module down on both compiler rungs, so every one of
//! std.map's twelve functions was refused until a `copy` its `List`
//! neighbour does not need went in. A store through a container
//! index lends now (`[mem.region.edge.elem]`); a FIELD store keeps the
//! refusal, in `region_conflict_params.lu`.

fn set_g[K, V](mut m: Map[K, V], k: K, v: V) {
    m[k] = v
}

fn push_g[T](mut xs: List[T], v: T) {
    (mut xs).push(v)
}

fn main() -> !int {
    var m = Map[str, int]()
    set_g(mut m, "a", 1)
    var xs = List[int]()
    push_g(mut xs, 7)
    push_g(mut xs, 8)
    print("{m.len} {m["a"] else 0} {xs.len}")
    0
}
