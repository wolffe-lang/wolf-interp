//! check: fail(E1001)
//! phase: typecheck
//! conforms: gram.expr.primary, gram.expr.closure, mem.tier0.move.1
//!
//! s190 (wolf-lang#486) — the shorthand inside a closure: `W { xs }`
//! moves the captured `xs`, which a borrowing closure cannot do, so the
//! answer is the longhand's: E1001 at the closure and at the later
//! `xs.len`. wolf 0.2.19 answered `unsupported` ("this field-init
//! shorthand") on native and release, because the shorthand's name was
//! looked up as a local and never as a capture.

struct W { xs: List[int] }

fn main() -> !int {
    var xs = [1]
    let f = fn() {   // ERROR E1001: the closure uses xs after its own body moved it
        var w = W { xs }
        (mut w.xs).push(9)
        w.xs.len
    }
    print("{f()} {xs.len}")   // ERROR E1001: xs moved inside f
    0
}
