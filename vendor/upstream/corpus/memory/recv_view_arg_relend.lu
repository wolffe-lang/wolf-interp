//! check: run(exit=0, stdout="10 9\n")
//! phase: run
//! conforms: mem.tier0.excl.3, mem.tier0.excl.4, mem.tier0.mode.mut, mem.model.order
//!
//! s193 (wolf-lang#494) — a view-set call on a `mut self` parameter,
//! re-lent from inside a method, the argument writing `self.z`. The
//! parameter is an address (no spill, no write-back), so this already
//! printed `10 9` on every wolfgang lane before s193. lupin 0.1.42
//! prints `10 3`.

struct V {
    x: int,
    y: int,
    z: int,
}

impl V {
    fn set_x(mut self.{x}, n: int) {
        self.x = self.x + n
    }

    fn outer(mut self) {
        (mut self).set_x({
            self.z = 9
            self.z
        })
    }
}

fn main() -> !int {
    var p = V { x: 1, y: 2, z: 3 }
    (mut p).outer()
    print("{p.x} {p.z}")
    0
}
