//! check: fail(E1010)
//! phase: typecheck
//! conforms: mem.region.escape, mem.region.create.3
//!
//! s227 (wolf-lang#660): a method's result drawn from its `read self`.
//! Trunk a027b643 built it and read freed bytes on native and release
//! (`ZZZZZZZZZZZZZZZZZZZZZ`, the chunk `other` reused), stale ones on the
//! checked machine; lupin traps `region-fault`.

struct Doc {
    title: str,
    n: int,
}

impl Doc {
    fn dup(self) -> Doc {
        Doc { title: copy self.title, n: self.n }
    }
}

fn main() -> !int {
    let st = region()
    in st {
        let seq0 = 0
        var o = Doc { title: "", n: 0 }
        region pass {
            let s = "built in pass, {seq0} uses"
            let d = Doc { title: s, n: 1 }
            in st {
                o = d.dup()
            }
        }
        region other {
            let z = "ZZZZZZZZZZZZZZZZZZZZZZZZZ{seq0}ZZ"
            print("{z.len}")
        }
        print("{o.title}")
    }
    0
}
