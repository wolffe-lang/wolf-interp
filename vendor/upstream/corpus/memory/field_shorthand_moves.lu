//! check: fail(E1001)
//! phase: typecheck
//! conforms: gram.expr.primary, mem.tier0.move.1, mem.tier0.move.2
//!
//! s190 (wolf-lang#486) — the struct field shorthand is the longhand:
//! `W { xs }` is `W { xs: xs }`, so it moves `xs`
//! (`[mem.tier0.move.1]`), and the read of `xs.len` after it is E1001.
//! Before s190 the shorthand carried no value node, the move checker
//! saw no move, and wolf 0.2.19 printed `2 2` on native and release:
//! two names on one buffer, the push through `w.xs` seen through `xs`.
//! The checked machine dropped the field and answered `unsupported`;
//! lupin 0.1.42 copies and prints `1 2` (wolf-interp#159).

struct W { xs: List[int] }

fn main() -> !int {
    var xs = [1]
    var w = W { xs }
    (mut w.xs).push(9)
    print("{xs.len} {w.xs.len}")   // ERROR E1001: xs moved into w
    0
}
