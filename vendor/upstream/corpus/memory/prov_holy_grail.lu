//! check: run(exit=0)
//! phase: mem
//! conforms: mem.tier0.mode.read, mem.ub, mem.prov.tag
//! (phase typecheck → mem in s73: the memory tier lowers closures now
//! — capture-as-read modeling; the wir rung still refuses fn values.)
//! The SB "holy grail" shape: a `read` parameter is immutable for the
//! whole call, so the second load may be hoisted/CSE'd across the opaque
//! callback (§7/O2). This file is the CONFORMING side: the program can't
//! observe the difference.

fn observe(xs: List[int], f: fn() -> int) -> int {
    let a = xs[0]                  // load
    let side = f()                 // opaque call — xs still Frozen for us
    let b = xs[0]                  // optimizer may reuse `a` (O2)
    a + b + side
}

fn main() -> !int {
    var xs = List[int]()
    (mut xs).push(20)
    let r = observe(xs, fn() 2)
    if r == 42 { 0 } else { 1 }
}
