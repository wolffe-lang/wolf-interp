//! check: run(exit=0)
//! phase: mem
//! conforms: mem.region.multiopen, mem.region.open.2, mem.region.create.2
//! FLAGGED FOR is07 MODEL CHECKING: two distinct regions open at once —
//! wolf's extension past Verona's single window. Distinctness is by
//! construction: region values are affine.

fn main() -> !int {
    let a = region()
    let b = region()
    var total = 0
    in a {
        var xs = List[int]()
        xs.push(1)
        in b {                     // both a and b open: [mem.region.multiopen]
            var ys = List[int]()
            ys.push(2)
            total += xs[0] + ys[0] // writes/reads cross both open regions
        }
        xs.push(3)
        total += xs[1]
    }
    if total == 6 { 0 } else { 1 }
}
