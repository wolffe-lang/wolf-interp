//! check: run(exit=0, stdout="10 9\n")
//! phase: run
//! conforms: mem.tier0.excl.3, mem.tier0.excl.4, mem.tier0.mode.mut, mem.model.order
//!
//! s193 (wolf-lang#494, found by s192) — a view-set receiver
//! (`mut self.{x}`) whose call's argument writes a field OUTSIDE the
//! view set. `[mem.tier0.excl.3]` leaves `p.z` the caller's while the
//! callee holds `p.x`, and `[mem.tier0.excl.4]` runs the argument
//! before the claim, so `p.z = 9` stands. Through s192 native and
//! release wrote the receiver back whole from its pre-argument spill
//! and printed `10 3`; checked printed `10 9`; lupin 0.1.42 prints
//! `10 3`.

struct V {
    x: int,
    y: int,
    z: int,
}

impl V {
    fn set_x(mut self.{x}, n: int) {
        self.x = self.x + n
    }
}

fn main() -> !int {
    var p = V { x: 1, y: 2, z: 3 }
    (mut p).set_x({
        p.z = 9
        p.z
    })
    print("{p.x} {p.z}")
    0
}
