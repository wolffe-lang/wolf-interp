//! check: fail(E1004)
//! phase: typecheck
//! conforms: mem.region.edge, mem.region.create.3
//! The one annotation Cyclone's measurement says exists (1 per 110
//! KLOC): storing one parameter's data into another parameter's
//! region. Parameter regions are fresh-and-generalized by default —
//! that independence is the zero-annotation contract — and no
//! equality surface exists yet, so the checker demands restructuring.
//! Dynamically the call below ties tmp-region data into a caller-
//! region container: a region-fault once tmp is freed.

struct Item { value: int }

struct Holder { item: Item }

fn stash(mut holder: Holder, take item: Item) {
    holder.item = item             // ERROR E1004: independent regions
}

fn main() -> !int {
    var h = Holder { item: Item { value: 1 } }
    region tmp {
        let i = Item { value: 2 }
        stash(mut h, take i)
    }
    if h.item.value == 2 { 0 } else { 1 }
}
