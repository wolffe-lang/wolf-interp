//! check: run(exit=0, stdout="10 2 9\n")
//! phase: run
//! conforms: mem.tier0.excl.3, mem.tier0.excl.4, mem.tier0.mode.mut, mem.model.order
//!
//! s193 (wolf-lang#494) — a view set of two fields (`mut self.{x, y}`)
//! with the third field written in the argument. The callee touches
//! only `x`; `y` comes back as it was and `z` keeps the argument's
//! write. Through s192 native and release printed `10 2 3`; lupin
//! 0.1.42 prints `10 2 3`.

struct V {
    x: int,
    y: int,
    z: int,
}

impl V {
    fn add(mut self.{x, y}, n: int) {
        self.x = self.x + n
    }
}

fn main() -> !int {
    var p = V { x: 1, y: 2, z: 3 }
    (mut p).add({
        p.z = 9
        p.z
    })
    print("{p.x} {p.y} {p.z}")
    0
}
