//! check: fail(E1002)
//! phase: typecheck
//! conforms: mem.tier0.mode.mut, mem.model.path.disjoint
//! The overlap rule's static half (D39, #27): a `Copy` read is an
//! instant, and left-to-right evaluation puts this one inside the
//! exclusive claim the first argument already spelled — `p.x` is read
//! while `p` is held `mut` by the same call. The two-phase receiver
//! shape (`xs.push(xs.len)`) stays legal: receiver claims activate at
//! call entry, after the arguments finish.

struct P { x: int, y: int }

fn bump(mut a: P, n: int) { a.x += n }

fn main() -> !int {
    var p = P { x: 1, y: 2 }
    bump(mut p, p.x)               // ERROR E1002: p.x is inside p
    p.x - 2
}
