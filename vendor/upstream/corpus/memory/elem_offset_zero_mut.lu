//! check: fail(E1002)
//! phase: typecheck
//! conforms: mem.model.place.elem, mem.tier0.excl.1
//!
//! eg03 — `[mem.model.place.elem]` item 4, R1's SAME half: `xs[i]`
//! and `xs[i + 0]` have equal offsets, so R1 makes them the same
//! element, never distinct: E1002 on every wolfgang lane. lupin 0.1.42
//! traps `exclusivity`.

fn add2(mut a: int, mut b: int) {
    a = a + 1
    b = b + 10
}

fn main() -> !int {
    var xs = [1, 2, 3]
    var i = 0
    add2(mut xs[i], mut xs[i + 0])  // ERROR E1002: equal offsets, one element
    print("{xs[0]} {xs[1]}")
    0
}
