//! check: fail(E1002)
//! phase: typecheck
//! conforms: mem.tier0.excl.4, mem.tier0.excl.1, mem.tier0.mode.mut, mem.model.order
//!
//! s192 (wolf-lang#487) — a view-set receiver (`mut self.{x}`,
//! `[mem.tier0.excl.3]`) whose own field is written inside the call's
//! argument. Through 0.2.19 the lanes disagreed with no diagnostic: the
//! checked machine printed `51` and native and release printed `2`
//! (the write was lost); lupin 0.1.42 prints `2`. E1002 now. A field
//! outside the view set stays the caller's (`recv_claim_arg_reads.lu`
//! does not write one: wolf-lang#494 tracks that shape).

struct V {
    x: int,
    y: int,
    z: int,
}

impl V {
    fn set_x(mut self.{x}, n: int) {
        self.x = self.x + n
    }
}

fn main() -> !int {
    var p = V { x: 1, y: 2, z: 3 }
    (mut p).set_x({
        p.x = 50  // ERROR E1002: p.x written inside its own receiver claim
        1
    })
    print("{p.x}")
    0
}
