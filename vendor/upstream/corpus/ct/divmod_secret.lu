//! check: fail(E1604)
//! phase: mem
//! conforms: ct.taint.sink
//! s112 sink (d): `%` on a secret operand refuses in ANY arithmetic
//! profile — hardware divide latency is operand-dependent on
//! mainstream cores, so no spelling of division over a secret is
//! constant-time (the diagnostic points at multiply-based reduction).

#[consttime]
fn residue(k: int) -> int {
    k % 3
}

fn main() -> !int {
    residue(5)
}
