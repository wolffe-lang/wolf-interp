//! check: fail(E1601)
//! phase: mem
//! conforms: ct.taint.sink
//! s112 sink (a): a branch on a secret-derived condition refuses at
//! the wir rung, fail-closed — timing the two sides reads the secret
//! bit by bit. Every parameter of a consttime fn is secret unless
//! `public(…)` names it ([ct.attr.secret]).

#[consttime]
fn leak(k: int) -> int {
    if k == 0 { 1 } else { 0 }
}

fn main() -> !int {
    leak(3)
}
