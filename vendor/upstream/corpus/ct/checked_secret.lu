//! check: fail(E1606)
//! phase: mem
//! conforms: ct.taint.sink
//! s112 the checked-tier collision: `k + 1` on a secret under
//! #[consttime] refuses — the checked profile's overflow trap IS a
//! secret-dependent branch by construction, and the refusal stands
//! even where a range proof could show the trap dead (the emitted
//! branch still exists; the proven-no-trap elision is named residue,
//! not built). The fix-it names wrapping[T] — the branch-free form
//! the std crypto kernels already ride.

#[consttime]
fn bump(k: int) -> int {
    k + 1
}

fn main() -> !int {
    bump(5) - 6
}
