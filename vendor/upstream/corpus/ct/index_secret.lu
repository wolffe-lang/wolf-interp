//! check: fail(E1602)
//! phase: mem
//! conforms: ct.taint.sink
//! s112 sink (b): a container index derived from a secret refuses —
//! which cache lines the access touches would depend on the secret
//! (the table-lookup-by-key-byte classic). The bounds guard that
//! protects the access classifies HERE, not as a branch: the index is
//! the sin and the diagnostic names it ([ct.taint.sink]).

#[consttime]
fn pick(xs: List[int], k: int) -> int {
    xs[k]
}

fn main() -> !int {
    var xs = List[int]()
    (mut xs).push(4)
    (mut xs).push(5)
    pick(xs, 0)
}
