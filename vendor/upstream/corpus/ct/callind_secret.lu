//! check: fail(E1603)
//! phase: mem
//! conforms: ct.taint.sink
//! s112 sink (c): an indirect call whose target derives from a secret
//! refuses — a fn-typed parameter of a consttime fn is secret by
//! default, and which function runs is observable through time, the
//! instruction cache, and the branch predictor.

#[consttime]
fn dispatch(f: fn(int) -> int, x: int) -> int {
    f(x)
}

fn id(v: int) -> int { v }

fn main() -> !int {
    dispatch(id, 1) - 1
}
