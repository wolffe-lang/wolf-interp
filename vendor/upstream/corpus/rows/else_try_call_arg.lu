//! check: run(exit=0, stdout="key\nlook a\nafter 5\n5\nkey\n9\n")
//! phase: run
//! conforms: type.row.else, err.else, err.propagate
//!
//! s191 (wolf-lang#492) — a `?` in a call argument under `else`. In
//! `look(m, key(ok)?) else 0` the `else` handles `look`'s own row,
//! `{none}`; `key`'s `parse` reaches the `?` first and leaves
//! `via_call`, so `after` never prints and the caller's `else 9`
//! answers. The checked machine's `else` caught the propagating `?`,
//! printed `after 0` and answered 0.

fn key(ok: bool) -> str ! {parse} {
    print("key")
    if ok { "a" } else { return parse }
}

fn look(m: Map[str, int], k: str) -> int ! {none} {
    print("look {k}")
    m[k]
}

fn via_call(m: Map[str, int], ok: bool) -> int ! {parse} {
    let v = look(m, key(ok)?) else 0
    print("after {v}")
    v
}

fn main() -> !int {
    var m = Map[str, int]()
    m["a"] = 5
    print("{via_call(m, true) else 9}")
    print("{via_call(m, false) else 9}")
    0
}
