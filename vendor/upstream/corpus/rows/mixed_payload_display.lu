//! check: run(exit=0, stdout="A(0)\nB(p)\nA(0)\nB(p)\n")
//! phase: run
//! conforms: err.rows, type.interp.row

// Mixed payload slots must be projected through the active tag (#950).
fn f(x: int) -> int ! {A(int), B(str)} {
    if x == 0 { return A(x) }
    if x == 1 { return B("p") }
    x
}

fn show(x: int) {
    let v = f(x) else |e| {
        print("{e}")
        let text = "{e}"
        assert(text == if x == 0 then "A(0)" else "B(p)")
        return
    }
    assert(v == 2)
}

fn main() {
    show(0)
    show(1)
    show(0)
    show(1)
    show(2)
}
