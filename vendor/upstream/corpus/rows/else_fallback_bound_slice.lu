//! check: run(exit=0, stdout="[ value]")
//! phase: run
//! conforms: gram.amb.else, mem.str.view
//!
//! s266 (wolf-lang#932) — the bound spelling of
//! `else_fallback_range_refused.lu`: the fallback is bound first, by
//! `let`, and the slice reads the binding.

fn main() -> int {
    let rest = "NAME := value"
    let p = rest.find(":=") else 0
    let v = rest[p + 2..]
    print("[{v}]")
    0
}
