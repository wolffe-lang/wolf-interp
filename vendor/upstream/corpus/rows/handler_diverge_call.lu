//! check: run(exit=0, stdout="got 7")
//! phase: run
//! conforms: err.union, err.rows
//!
//! #35, narrowed — divergence by CALL in fallback position. A generic
//! handler whose tail is `assert(false)` used to fail E0401 ("this is
//! `()`, but the `else` fallback must produce `T`") while the same
//! handler diverging by `return` already checked: the literal
//! `assert(false)` now types as `!` (bottom) and inhabits the `T` the
//! fallback owes. SCOPE (deliberate, s108): only the spelled-out
//! literal — a computed condition stays `()`, and no `never` FUNCTION
//! type exists; `testing.fail`-shaped calls are the surface question
//! that stays open on #35. This is the hit path: the handler never
//! runs, on any lane. Its trap twin is `handler_diverge_trap.lu`.
//!
//! s165 (#366): the tail is `copy hit` — `hit` holds `v`, a `read` parameter
//! of type `T`, and handing it back as itself is E1002.

fn expect[T](v: T ! {none}, msg: str) -> T {
    let hit = v else |_| {
        print("FAILED: {msg}")
        assert(false)
    }
    copy hit
}

fn pick(x: int) -> int ! {none} {
    if x < 1 { return none }
    x
}

fn main() -> !int {
    let a = expect(pick(7), "seven")
    print("got {a}")
    if a == 7 { 0 } else { 1 }
}
