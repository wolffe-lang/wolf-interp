//! check: run(exit=trap(assert), stdout="FAILED: neg")
//! phase: run
//! conforms: err.union, err.rows, conf.trap.set
//!
//! `handler_diverge_call.lu`'s trap twin (#35, narrowed): the miss
//! path actually TAKES the diverging fallback — the generic handler
//! prints its message and `assert(false)` ends the process with the
//! `assert` trap kind, the D30 divergence-is-ordinary-control-flow
//! story. All three lanes agree on the trap. The checked executor
//! used to refuse the raising call in argument position by name
//! ("control flow in an argument") on exactly this path, the one that
//! raises; since wolf-lang#201 the raw row binds to the parameter the
//! way it binds at `let`, and the checked lane runs this file. The
//! hoisted spelling (`let p = pick(0)`, then `expect(p, …)`) answers
//! the same trap on the checked lane since #122.
//!
//! s165 (#366): the tail is `copy hit`, as in `handler_diverge_call.lu`.

fn expect[T](v: T ! {none}, msg: str) -> T {
    let hit = v else |_| {
        print("FAILED: {msg}")
        assert(false)
    }
    copy hit
}

fn pick(x: int) -> int ! {none} {
    if x < 1 { return none }
    x
}

fn main() -> !int {
    let a = expect(pick(0), "neg")
    print("got {a}")
    if a == 0 { 0 } else { 1 }
}
