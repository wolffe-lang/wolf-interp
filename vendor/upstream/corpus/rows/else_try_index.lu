//! check: run(exit=0, stdout="let\nkey\nafter 5\n5\nkey\n9\ntail\nkey\n5\nkey\n9\n")
//! phase: run
//! conforms: type.row.else, err.else, err.propagate
//!
//! s191 (wolf-lang#492) — a `?` in a `Map` index under `else`. In
//! `m[key(ok)?] else 0` the `else` handles the index's own row
//! (`{none}`, an absent key); `key`'s `parse` leaves the function
//! through the `?`. Bound by `let` and as the function's tail. The
//! checked machine's `else` caught the propagating `?` and answered 0.

fn key(ok: bool) -> str ! {parse} {
    print("key")
    if ok { "a" } else { return parse }
}

fn via_index(m: Map[str, int], ok: bool) -> int ! {parse} {
    let v = m[key(ok)?] else 0
    print("after {v}")
    v
}

fn tail_index(m: Map[str, int], ok: bool) -> int ! {parse} {
    m[key(ok)?] else 0
}

fn main() -> !int {
    var m = Map[str, int]()
    m["a"] = 5
    print("let")
    print("{via_index(m, true) else 9}")
    print("{via_index(m, false) else 9}")
    print("tail")
    print("{tail_index(m, true) else 9}")
    print("{tail_index(m, false) else 9}")
    0
}
