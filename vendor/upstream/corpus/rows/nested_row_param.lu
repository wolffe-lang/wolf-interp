//! check: run(exit=0)
//! phase: run
//! conforms: gram.type.row, gram.type.row.flatten, err.union
//!
//! #34's parameter half, ruled by D51: rows are first-class in every
//! type position (#3), so the nested form parses where a single row
//! does — and flattens the same way ([gram.type.row.flatten]):
//! `int ! {none} ! {none}` is `int ! {none}`. The call is the D30
//! boundary machinery at an argument: `3` injects as the ok half
//! (the widening a fallible return operand gets), `take_nested`
//! answers 7. Pinned at `run` since s109, agreeing with lupin (which
//! always ran it).

fn take_nested(v: int ! {none} ! {none}) -> int {
    7
}

fn main() -> !int {
    if take_nested(3) == 7 { 0 } else { 1 }
}
