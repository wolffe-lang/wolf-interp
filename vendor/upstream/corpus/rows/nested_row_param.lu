//! check: run(exit=0)
//! phase: resolve
//! conforms: gram.type.row, err.union
//!
//! #34's parameter half: rows are first-class in every type position
//! (#3), so the nested form must parse where a single row does — this
//! was fail(E0201) at the parameter list before s108, while lupin ran
//! it. Sema holds the nested type opaque and refuses the body by
//! name (see `nested_row_return.lu` — same D-question, same honest
//! unsupported). The run expectation is the flattening reading a
//! ruling would most likely pin (`3` widens in, `take_nested`
//! answers 7); it starts gating when the pin advances.

fn take_nested(v: int ! {none} ! {none}) -> int {
    7
}

fn main() -> !int {
    if take_nested(3) == 7 { 0 } else { 1 }
}
