//! check: run(exit=0)
//! phase: run
//! conforms: gram.type.row, gram.type.row.flatten, err.union
//!
//! #34, ruled by D51 — a row inside a row, return position. The
//! grammar's `type '!' error_row` production admits its own result,
//! so `int ! {none} ! {none}` PARSES (fail(E0201) before s108), and
//! the nested union FLATTENS: `T ! {a} ! {b}` is `T ! {a ∪ b}`, one
//! union with the tags merged ([gram.type.row.flatten]). The same
//! payload-free tag in both layers is ONE tag — rows are structural
//! sets, and set union is the only reading the row model expresses
//! without a wrapper the surface doesn't have. lupin has always run
//! this file (its two miss layers were indistinguishable — now the
//! ruled behavior); the differential is byte-equal. Pinned at `run`
//! since s109: both layers behave, `nest(16)` is 16.

fn nest(x: int) -> int ! {none} ! {none} {
    if x < 1 { return none }
    x
}

fn main() -> !int {
    let v = nest(16) else { return 1 }
    if v == 16 { 0 } else { 1 }
}
