//! check: run(exit=0)
//! phase: resolve
//! conforms: gram.type.row, err.union
//!
//! #34 — a row inside a row, return position. The grammar's
//! `type '!' error_row` production admits its own result, so
//! `int ! {none} ! {none}` PARSES (it was fail(E0201) before s108,
//! with the caret under the second `!`; lupin has always run it).
//! What a nested union MEANS — one flattened row or a distinct
//! layer — is a spec question no row clause answers ([gram.type.row]
//! spells the form, D30 rules single unions), so sema refuses it by
//! name: "a nested error row (its meaning is not ruled yet)", an
//! honest unsupported at typecheck, never a guessed semantics and
//! never a parse error for a shape the grammar derives. Pinned at
//! `resolve` — the run expectation is lupin's answer (both layers
//! behave, `nest(16)` is 16) and starts gating the day the
//! D-question is ruled and the pin advances.

fn nest(x: int) -> int ! {none} ! {none} {
    if x < 1 { return none }
    x
}

fn main() -> !int {
    let v = nest(16) else { return 1 }
    if v == 16 { 0 } else { 1 }
}
