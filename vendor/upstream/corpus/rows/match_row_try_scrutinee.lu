//! check: run(exit=0, stdout="key\nlook a\nafter 5\n5\nkey\nlook a\nafter -1\n-1\nkey\n9\n")
//! phase: run
//! conforms: type.row.match, type.row.else, err.union, err.propagate
//!
//! s197 (wolf-lang#497, ruling #21) — the #492 shape on a `match`: a
//! `?` that fires INSIDE the scrutinee (`look(m, key(ok)?)`) leaves
//! the function past the arms, exactly as it leaves past an `else`
//! (`[type.row.else]`); the arms handle `look`'s own row only. The
//! caller's `else 9` sees `key`'s `parse`. On the checked machine a
//! propagating row (`Flow::Err(_, true)`) must never reach the row
//! arms.

fn key(ok: bool) -> str ! {parse} {
    print("key")
    if ok { "a" } else { return parse }
}

fn look(m: Map[str, int], k: str) -> int ! {none} {
    print("look {k}")
    m[k]
}

fn try_match(m: Map[str, int], ok: bool) -> int ! {parse} {
    let r = match look(m, key(ok)?) {
        none => -1,
        v => v,
    }
    print("after {r}")
    r
}

fn main() -> !int {
    var m = Map[str, int]()
    m["a"] = 5
    let empty = Map[str, int]()
    print("{try_match(m, true) else 9}")
    print("{try_match(empty, true) else 9}")
    print("{try_match(m, false) else 9}")
    0
}
