//! check: fail(E0816)
//! phase: resolve
//! conforms: type.row.match
//!
//! s197 (wolf-lang#497, ruling #21) — `Shape ! {Line(int)}`: the tag
//! `Line` is also a variant of the value type, so an arm `Line(k)`
//! could be either half. The match is refused by name (E0816), never
//! guessed, whether or not an arm spells `Line`; `else |e| match e {
//! … }` is the spelling that keeps the halves apart.

enum Shape {
    Dot,
    Line(int),
}

fn pick(n: int) -> Shape ! {Line(int)} {
    if n > 0 { return Shape.Line(n) }
    Shape.Dot
}

fn main() -> !int {
    let v = match pick(1) {
        Line(k) => k,
        Dot => 0,
    }
    v
}
