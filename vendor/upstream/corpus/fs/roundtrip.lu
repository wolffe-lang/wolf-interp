//! check: run(exit=0, stdout="read: three wolves\ngone: true")
//! phase: run
//! conforms: err.union
//!
//! fs v0 (s38): write, read back, remove — over D30 rows, never
//! traps. Both lanes execute this against the real filesystem since
//! s40 (`wolf_rt::fs` mirrors the checked `io_fs_builtin` call for
//! call; the checked-lane twin in `crates/wolf_mem/tests/io_fs.rs`
//! runs the same shape under a temp directory). `errdefer`-style
//! cleanup idioms arrive with the std facade (stdc02).

fn main() -> !int {
    let path = "target/s38-fs-roundtrip.tmp"
    fs_write_text(path, "three wolves\n")?
    let text = fs_read_text(path)?
    print("read: {text.trim()}")
    fs_remove(path)?
    print("gone: {!fs_exists(path)}")
    0
}
