//! check: run(exit=0, stdout="{who}")
//! phase: run
//! conforms: diag.sev.warn, gram.lex.str, gram.lex.str.raw
//! warns: W0309
//!
//! W0309 — interpolation-shaped braces in a raw literal: `r"{who}"`
//! is six bytes, while the same characters in any other literal are
//! an interpolation. One keystroke apart, different strings, no
//! diagnostic — hence the warning.
//!
//! Advanced from `phase: wir` to `run` by s108 (#76): the s40 pin
//! parked a SHARED naive first/last-byte quote strip that left the
//! `"` from `r"` in the value on both executors. lupin fixed its
//! decode first (the v0.1.10 differential caught the one-sided
//! residue); wolfgang's decoders now strip the full opening
//! delimiter too, so the six-byte expectation this header always
//! carried is the regression witness on every run-reaching lane.

fn main() -> !int {
    let who = "reader"
    let s = r"{who}"
    print(s)
    if who == "reader" { 0 } else { 1 }
}
