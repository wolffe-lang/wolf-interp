//! check: run(exit=0, stdout="{who}")
//! phase: wir
//! conforms: diag.sev.warn, gram.lex.str
//! warns: W0309
//!
//! W0309 — interpolation-shaped braces in a raw literal: `r"{who}"`
//! is six bytes, while the same characters in any other literal are
//! an interpolation. One keystroke apart, different strings, no
//! diagnostic — hence the warning.
//!
//! Pinned at `wir`, not `run` (s40): BOTH executors decode the raw
//! literal with the naive first/last-byte quote strip, which leaves
//! the `"` from `r"` in the value — they agree with each other
//! (`"{who}` on both lanes) but not with this header's six-byte
//! expectation. The raw-prefix strip is a shared decode fix owed by
//! the string tier, tracked in the s40 closeout.

fn main() -> !int {
    let who = "reader"
    let s = r"{who}"
    print(s)
    if who == "reader" { 0 } else { 1 }
}
