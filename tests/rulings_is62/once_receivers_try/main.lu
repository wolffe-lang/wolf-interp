//! check: run(exit=0, stdout="copy\nidx\n9\ncount\nidx\n9\nfor\nidx\n9\nelemcopy\nidx\n5\nidx\n9\npush\nidx\n3\nidx\n9\nbytes\nidx\n9\nbytesfor\nidx\n9\nstrlen\nidx\n9\nprint\nidx\ncde\n0\nidx\n9\n")
//! phase: run
//! conforms: mem.model.order, mem.model.place
//!
//! s189 (wolf-lang#481) — an index operand whose `?` propagates, under
//! the other readers of a place: `copy`, a method receiver (`count`,
//! `(mut …).push`), a `for` iterable, the right-hand side of an element
//! store, a `str` element's byte view (`.bytes().len`, `for b in
//! ….bytes()`), a `str` element's `.len`, and a `print` argument. The
//! operand runs once in each. The checked machine ran it three times,
//! six under a byte view. lupin 0.1.42 runs it twice as a method
//! receiver, under a byte view and under a `str` member (the driver
//! gate pins that answer by version).

fn idx(ok: bool) -> int ! {parse} {
    print("idx")
    if ok { 1 } else { return parse }
}

fn cp(rows: List[List[int]], ok: bool) -> int ! {parse} {
    let r = copy rows[idx(ok)?]
    r.len
}

fn cnt(rows: List[List[int]], ok: bool) -> int ! {parse} {
    rows[idx(ok)?].count()
}

fn loop_over(rows: List[List[int]], ok: bool) -> int ! {parse} {
    var t = 0
    for v in rows[idx(ok)?] {
        t = t + v
    }
    t
}

fn elem_copy(mut xs: List[int], ys: List[int], ok: bool) -> int ! {parse} {
    xs[0] = ys[idx(ok)?]
    xs[0]
}

fn push_into(mut rows: List[List[int]], ok: bool) -> int ! {parse} {
    (mut rows[idx(ok)?]).push(9)
    rows[1].len
}

fn blen(ss: List[str], ok: bool) -> int ! {parse} {
    ss[idx(ok)?].bytes().len
}

fn bfor(ss: List[str], ok: bool) -> int ! {parse} {
    var n = 0
    for b in ss[idx(ok)?].bytes() {
        n = n + 1
    }
    n
}

fn slen(ss: List[str], ok: bool) -> int ! {parse} {
    ss[idx(ok)?].len
}

fn pr(ss: List[str], ok: bool) -> int ! {parse} {
    print(ss[idx(ok)?])
    0
}

fn main() -> !int {
    var rows = [[1], [2, 3]]
    var xs = [10, 20, 30]
    var ss = ["ab", "cde"]
    print("copy")
    print("{cp(rows, false) else 9}")
    print("count")
    print("{cnt(rows, false) else 9}")
    print("for")
    print("{loop_over(rows, false) else 9}")
    print("elemcopy")
    let e1 = elem_copy(mut xs, [4, 5], true) else 9
    print("{e1}")
    let e2 = elem_copy(mut xs, [4, 5], false) else 9
    print("{e2}")
    print("push")
    let p1 = push_into(mut rows, true) else 9
    print("{p1}")
    let p2 = push_into(mut rows, false) else 9
    print("{p2}")
    print("bytes")
    print("{blen(ss, false) else 9}")
    print("bytesfor")
    print("{bfor(ss, false) else 9}")
    print("strlen")
    print("{slen(ss, false) else 9}")
    print("print")
    print("{pr(ss, true) else 9}")
    print("{pr(ss, false) else 9}")
    0
}
