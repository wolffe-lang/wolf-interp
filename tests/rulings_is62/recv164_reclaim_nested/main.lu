//! check: fail(E1002)
//! phase: typecheck
//! conforms: mem.tier0.excl.4, mem.tier0.excl.1, mem.tier0.mode.mut, mem.model.order
//!
//! s192 (wolf-lang#487) — the `mut` receiver claimed again by a call
//! INSIDE its own argument. Through 0.2.19 every wolfgang lane ran it
//! and printed `4 7`; lupin 0.1.42 answers `ub(mem.ub)`. E1002 now.

fn main() -> !int {
    var xs = [1, 2]
    (mut xs).push({
        (mut xs).push(7)  // ERROR E1002: xs claimed inside its own receiver claim
        5
    })
    print("{xs.len} {xs[2]}")
    0
}
