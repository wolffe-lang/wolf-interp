//! check: fail(E1001)
//! phase: typecheck
//! conforms: gram.expr.primary, mem.tier0.move.1, mem.tier0.move.2
//!
//! s190 (wolf-lang#486) — shorthand and longhand mixed in one literal:
//! `M { xs, n, ys: ys }` moves `xs` exactly as `xs: xs` would, copies
//! `n`, and moves `ys`. The read of `xs.len` after it is E1001. wolf
//! 0.2.19 printed `2 2 2 1` on native and release (lupin 0.1.42:
//! `1 2 2 1`).

struct M { xs: List[int], n: int, ys: List[int] }

fn main() -> !int {
    var xs = [1]
    let n = 2
    var ys = [3]
    var m = M { xs, n, ys: ys }
    (mut m.xs).push(9)
    print("{xs.len} {m.xs.len} {m.n} {m.ys.len}")   // ERROR E1001: xs moved into m
    0
}
