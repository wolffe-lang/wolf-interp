//! check: run(exit=0, stdout="3\n")
//! phase: run
//! conforms: mem.tier0.excl.4, mem.tier0.excl.1, mem.model.order, mem.model.place.elem
//!
//! s186 (wolf-lang#476, the first of s185's two shapes; ruled
//! two-phase, `[mem.tier0.excl.4]`) — a whole-reading RECEIVER in a
//! later argument: `get` reads all of `xs` (1(c): only `len`, `count`
//! and `is_empty` are header reads), and the read ends before the claim
//! on `xs[0]` takes effect. `get(1)` is 2, `xs[0]` becomes 3. lupin
//! 0.1.42 traps `exclusivity` (pre-mirror).

fn bump(mut a: int, n: int) {
    a = a + n
}

fn main() -> !int {
    var xs = [1, 2, 3]
    bump(mut xs[0], xs.get(1) else 9)
    print("{xs[0]}")
    0
}
