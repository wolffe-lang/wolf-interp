//! is63 (ruling #17) — still a trap: a closure that captures the claimed place, passed into the same call — a lend (`[mem.tier0.excl.4]`), `grow2(mut xs, fn() { xs.len })`.

fn grow2(mut ys: List[int], f: fn() -> int) {
    (mut ys).push(f())
}

fn main() -> !int {
    var xs = [1, 2, 3]
    grow2(mut xs, fn() { xs.len })
    print("{xs.len} {xs[3]}")
    0
}
