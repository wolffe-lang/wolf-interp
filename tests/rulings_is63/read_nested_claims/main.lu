//! is63 (ruling #17) — an inner call's arguments read the OUTER call's claimed place: `outer(mut a, inner(mut b, a + b))`.

fn inner(mut b: int, n: int) -> int {
    b = b + n
    b
}

fn outer(mut a: int, n: int) {
    a = a + n
}

fn main() -> !int {
    var a = 1
    var b = 10
    outer(mut a, inner(mut b, a + b))
    print("{a} {b}")
    0
}
