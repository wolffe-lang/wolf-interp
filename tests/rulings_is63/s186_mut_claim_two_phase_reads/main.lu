//! check: run(exit=0, stdout="2 4 23 1 3 5 2 3\n")
//! phase: run
//! conforms: mem.tier0.excl.4, mem.model.order, mem.model.place.elem
//!
//! s186 (ruled 2026-09-30, `[mem.tier0.excl.4]`: arguments are
//! two-phase) — the reads a later argument may make of a place an
//! earlier `mut` argument claims, each seeing the value from before the
//! call: a direct `Copy` read of the claimed place (`bump(mut a, a)`,
//! E1002 under D39 through 0.2.19), a direct member read of a claimed
//! container (`grow(mut xs, xs.len)`, E1002 through 0.2.19), and the
//! downstream shapes s186 measured in boreutils and lobo — a field read
//! by string interpolation (`fail(mut fl, "…{fl.store}")`), a header
//! read in an operand (`ensure(mut f, f.len + 3)`) and a nested call
//! over the claimed struct (`ring_drop(mut r, ring_len(r))`). Last, a
//! receiver claim beside a sibling field's header (bu12's `tr.lu:528`
//! shape): disjoint paths, and a read either way. lupin 0.1.42 traps
//! the claimed-place reads `exclusivity` (pinned pre-mirror in the
//! gate; is63 moves lupin).

struct Fl {
    store: str,
    n: int,
}

struct Ring {
    buf: List[int],
    head: int,
}

struct Out {
    bytes: List[int],
    class_off: List[int],
}

fn bump(mut a: int, n: int) {
    a = a + n
}

fn grow(mut ys: List[int], n: int) {
    (mut ys).push(n)
}

fn fail(mut fl: Fl, msg: str) -> int {
    fl.n = fl.n + 1
    msg.len
}

fn ensure(mut f: List[int], want: int) {
    while f.len < want {
        (mut f).push(0)
    }
}

fn ring_len(r: Ring) -> int {
    r.buf.len - r.head
}

fn ring_drop(mut r: Ring, n: int) {
    r.head = r.head + n
}

fn main() -> !int {
    var a = 1
    bump(mut a, a)
    var xs = [1, 2, 3]
    grow(mut xs, xs.len)
    var fl = Fl { store: "/var", n: 0 }
    let k = fail(mut fl, "cannot write under {fl.store}")
    var f = [1, 2]
    ensure(mut f, f.len + 3)
    var r = Ring { buf: [1, 2, 3], head: 0 }
    ring_drop(mut r, ring_len(r))
    var out = Out { bytes: [7, 8], class_off: List[int]() }
    (mut out.class_off).push(out.bytes.len)
    print("{a} {xs.len} {k} {fl.n} {r.head} {f.len} {out.class_off[0]} {xs[3]}")
    0
}
