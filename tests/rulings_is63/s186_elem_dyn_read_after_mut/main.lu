//! check: run(exit=0, stdout="3 2\n")
//! phase: run
//! conforms: mem.model.place.elem, mem.tier0.excl.4, mem.model.order
//!
//! eg02 (EGC's EG2) — `[mem.model.place.elem]` item 2, ONE PLACE: the twin
//! of `elem_const_read_after_mut.lu` through a run-time index,
//! `bump(mut xs[0], xs[i])`. No rule proves `i != 0`, so `xs[i]` may be
//! the claimed element — but since s186 (`[mem.tier0.excl.4]`, ruled
//! 2026-09-30) a later argument may READ a claimed place: the claim
//! takes effect at call entry, after the read. E1002 through 0.2.19;
//! now `3 2` on every wolfgang lane, lupin's bytes (it sees `i = 1`).

fn bump(mut a: int, n: int) {
    a = a + n
}

fn main() -> !int {
    var xs = [1, 2, 3]
    var i = 1
    bump(mut xs[0], xs[i])
    print("{xs[0]} {xs[1]}")
    0
}
