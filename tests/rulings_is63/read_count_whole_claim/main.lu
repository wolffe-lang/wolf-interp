//! is63 (ruling #17) — a header method under a claim on the WHOLE container: `grow(mut xs, xs.count())`, s186's `mut_claim_nested_header.lu`.

fn grow(mut ys: List[int], n: int) {
    (mut ys).push(n)
}

fn main() -> !int {
    var xs = [1, 2, 3]
    grow(mut xs, xs.count())
    print("{xs[3]} {xs.len}")
    0
}
