//! is63 (ruling #17) — an impl method's `self` reads the claimed struct whole in a later argument: `bump(mut p.y, p.count())` (is60's `twin_impl_count_under_field_claim`).

struct P { x: List[int], y: int }

impl P {
    fn count(self) -> int {
        self.x.len
    }
}

fn bump(mut a: int, n: int) {
    a = a + n
}

fn main() -> !int {
    var p = P { x: [1, 2], y: 3 }
    bump(mut p.y, p.count())
    print("{p.y}")
    0
}
