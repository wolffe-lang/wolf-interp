//! check: run(exit=0)
//! phase: resolve
//! conforms: mem.region.freeze.1, mem.prov.state
//! The twin of `p2_frozen_write.lu`: a Frozen tag *reads* perfectly well,
//! twice. `[mem.prov.state]` says Frozen permits child reads and foreign
//! reads alike — the state exists to make read-read reordering legal, not to
//! forbid reading.

import c "stdlib.h"

fn main() -> !int {
    let r = region()
    unsafe {
        let p = in r { c.malloc(8) as *u8 }
        p[0] = 21
        let frozen = freeze r
        let a = p[0] as int
        let b = p[0] as int
        if a + b == 42 { 0 } else { 1 }
    }
}
