//! check: run(exit=0)
//! phase: resolve
//! conforms: mem.prov.tag, mem.prov.state
//! The near-miss twin of `p1_protector.lu`: the *same* aliasing pointers, the
//! same call, the conflicting write moved to **after** the call returns. The
//! protector's extent is the call and nothing more, so once it lifts the write
//! merely Disables a tag nothing will read again — defined, and the whole
//! reason O1's noalias fact is a call-extent fact rather than a global one.

import c "stdlib.h"

fn observe(a: *u8, mut b: *u8) -> int {
    let x = a[0] as int
    let y = b[0] as int
    x + y
}

fn main() -> !int {
    unsafe {
        let p = c.malloc(8) as *u8
        p[0] = 1
        var q = p
        let n = observe(p, mut q)
        q[0] = 3
        c.free(p)
        if n == 2 { 0 } else { 1 }
    }
}
