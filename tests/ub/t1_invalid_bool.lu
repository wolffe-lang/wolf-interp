//! check: run(exit=trap(ub))
//! phase: resolve
//! conforms: mem.ub, mem.unsafe.raw.1
//! §7/T1: producing an invalid value of a restricted type in unsafe code —
//! "bool ∉ {0,1}" is the row's own first example. The byte is a perfectly good
//! `u8`; it is the *production of a `bool`* from it that has no defined
//! behavior. O9 is the pairing: niche packing (`Option[handle T]` in one word),
//! match jump tables with no default arm, and UTF-8 fast paths that re-validate
//! nothing.

import c "stdlib.h"

fn main() -> !int {
    unsafe {
        let p = c.malloc(8) as *u8
        p[0] = 7
        let flag = p[0] as bool
        c.free(p)
        if flag { 0 } else { 1 }
    }
}
