//! check: run(exit=trap(ub))
//! phase: resolve
//! conforms: mem.tier0.mode.read, mem.prov.state, mem.ub
//! §7/P2: a write through a Frozen tag. A `read`-mode parameter is immutable
//! for the whole call (`[mem.tier0.mode.read]`), which `[mem.prov.tag]` makes
//! operational as a **Frozen child tag** — so the callee writing through it has
//! no defined behavior. This is the row that licenses O2, the Stacked-Borrows
//! "holy grail": a load may be hoisted or CSE'd across an opaque call because
//! the call cannot have written.

import c "stdlib.h"

fn poke(p: *u8) -> int {
    p[0] = 9
    0
}

fn main() -> !int {
    unsafe {
        let p = c.malloc(8) as *u8
        p[0] = 1
        let n = poke(p)
        c.free(p)
        n
    }
}
