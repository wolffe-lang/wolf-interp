//! check: run(exit=trap(ub))
//! phase: resolve
//! conforms: mem.region.freeze.1, mem.prov.state, mem.ub
//! §7/P2: a write through a Frozen tag. `freeze r` transitions every tag of
//! every allocation the region owns to Frozen (`[mem.region.freeze.1]` made
//! operational by `[mem.prov.state]`) — so a later raw write through a
//! pointer into the frozen region has no defined behavior. This is the row
//! that licenses O2: a load from frozen data may be hoisted or CSE'd across
//! anything, because nothing defined can have written. (The read-mode
//! parameter form of this trigger retired at pin f0da6e6: its `*u8`
//! parameter is outside the language — E1302, `[mem.unsafe.scope]`.)

import c "stdlib.h"

fn main() -> !int {
    let r = region()
    unsafe {
        let p = in r { c.malloc(8) as *u8 }
        p[0] = 1
        let frozen = freeze r
        p[0] = 9
        0
    }
}
