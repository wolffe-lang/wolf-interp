//! check: run(exit=trap(ub))
//! phase: resolve
//! conforms: mem.unsafe.raw.1, mem.ub
//! §7/L4 (ruling #36 = A, wolf-lang#574; `[mem.unsafe.raw.4]` at the pin
//! that carries s209): an ordinary `*u32` read at an address that is not a
//! multiple of the pointee's alignment. `with_addr` keeps the allocation's
//! provenance one byte past an aligned base, so every other row is clean —
//! in bounds, initialized by `calloc`, the tag live — and only the address
//! is wrong. O12 is the pairing: the compiled tiers emit every ordinary raw
//! access at its natural alignment (`align 4`), with no check.

import c "stdlib.h"

fn main() -> int {
    // # Safety: DELIBERATELY UNSOUND — the misaligned read is the row.
    unsafe {
        let p = c.calloc(1, 16) as *u32
        let q = p.with_addr(p.addr() + 1)
        let v = q[0] as int
        c.free(p as *u8)
        v
    }
}
