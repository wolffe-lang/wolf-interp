//! check: run(exit=0, stdout="sym=sym gone=true\n")
//! phase: run
//! conforms: os.fs.path.domain
//!
//! s182 — the CONTROL for `fs_path_symlink_out`: the same write through
//! a symlinked directory that stays INSIDE the tree (`setup.sh` makes
//! `target/s182_in_link -> s182_in`). A relative path, no `..`,
//! resolving inside: every machine must serve it, including a
//! confining one. wolf does on both tiers; lupin 0.1.38 answers
//! `exit(1)` `error: not_found` here too, which is what shows the
//! `_out` case is not a confinement decision. Not in the prediction
//! (§3 said nine parked); added when the control was needed.

fn main() -> !int {
    let path = "target/s182_in_link/s182_probe_sym.txt"
    fs_write_text(path, "sym")?
    let text = fs_read_text(path)?
    fs_remove(path)?
    print("sym={text} gone={!fs_exists(path)}")
    0
}
