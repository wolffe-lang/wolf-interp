import c "stdlib.h"

fn main() -> int {
    // # Safety: one live 8-byte allocation, aligned, one task.
    unsafe {
        let p = c.calloc(1, 8) as *f64
        let a = p.atomic_load(Order.seq_cst)
        c.free(p as *u8)
    }
    0
}
