//! check: fail(E1309)
//! phase: resolve
//! conforms: conc.mm.atomic.order
//!
//! is74 probe: `Order` used as a value, outside an order operand.

import c "stdlib.h"

fn main() -> int {
    // # Safety: one live 8-byte allocation, aligned, one task.
    unsafe {
        let p = c.calloc(1, 8) as *u64
        let o = Order.acquire
        c.free(p as *u8)
    }
    0
}
