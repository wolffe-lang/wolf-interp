//! check: fail(E1309)
//! phase: resolve
//! conforms: conc.mm.atomic.raw.2, conc.mm.atomic.order
//!
//! is74 probe: a store has no acquire half, so not `acq_rel` either.

import c "stdlib.h"

fn main() -> int {
    // # Safety: one live 8-byte allocation, aligned, one task.
    unsafe {
        let p = c.calloc(1, 8) as *u64
        p.atomic_store(1, Order.acq_rel)
        c.free(p as *u8)
    }
    0
}
