//! check: run(exit=trap(ub))
//! phase: wir
//! conforms: mem.unsafe.volatile.3, mem.ub
//!
//! kw07: a volatile access at an address that is not a multiple of the
//! pointee's size is §7 row L3 (`[mem.unsafe.volatile.3]`): the checked
//! machine traps `ub` with x-ub-row L3, clause mem.unsafe.volatile. The
//! licensed optimization is O11 — the compiled tiers emit one aligned
//! access and no check, so what they do here is undefined: they compile
//! and run it (`with_addr` lowers since kw06), and `wir` is the deepest
//! phase this header can promise, as for `volatile_ub_uaf.lu`.

import c "stdlib.h"

fn main() -> int {
    // # Safety: DELIBERATELY UNSOUND — the misaligned read is the row.
    unsafe {
        let p = c.calloc(1, 8) as *u32
        let q = p.with_addr(p.addr() + 2)
        let v = q.read_volatile()  // UB L3: address % 4 == 2
        c.free(p as *u8)
        v as int
    }
}
