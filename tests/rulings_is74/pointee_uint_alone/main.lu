//! check: fail(E1308)
//! phase: resolve
//! conforms: conc.mm.atomic.raw.1
//!
//! is74 probe: `*uint` alone.

import c "stdlib.h"

fn main() -> int {
    // # Safety: one live 8-byte allocation, aligned, one task.
    unsafe {
        let p = c.calloc(1, 8) as *uint
        let a = p.atomic_add(1, Order.relaxed)
        c.free(p as *u8)
    }
    0
}
