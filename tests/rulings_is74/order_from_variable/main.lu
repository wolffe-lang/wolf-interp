//! is74 probe: an order operand that is not a mark (a variable).

import c "stdlib.h"

fn main() -> int {
    // # Safety: one live 8-byte allocation, aligned, one task.
    unsafe {
        let p = c.calloc(1, 8) as *u64
        let k = 1
        let a = p.atomic_load(k)
        c.free(p as *u8)
    }
    0
}
