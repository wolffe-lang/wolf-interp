//! check: run(exit=trap(ub))
//! phase: wir
//! conforms: conc.mm.atomic.raw.4, mem.unsafe.raw.4, mem.ub
//!
//! is74 probe: a `*u32` store two bytes off: row L4.

import c "stdlib.h"

fn main() -> int {
    // # Safety: DELIBERATELY UNSOUND — the misaligned atomic is the row.
    unsafe {
        let p = c.calloc(2, 8) as *u32
        let q = p.with_addr(p.addr() + 2)
        q.atomic_store(5, Order.release)
        c.free(p as *u8)
    }
    0
}
