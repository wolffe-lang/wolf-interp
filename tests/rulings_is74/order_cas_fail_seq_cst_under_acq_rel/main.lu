//! check: fail(E1309)
//! phase: resolve
//! conforms: conc.mm.atomic.raw.2, conc.mm.atomic.order
//!
//! is74 probe: a `seq_cst` failure order needs a `seq_cst` success order.

import c "stdlib.h"

fn main() -> int {
    // # Safety: one live 8-byte allocation, aligned, one task.
    unsafe {
        let p = c.calloc(1, 8) as *u64
        let r = p.atomic_cas(0, 1, Order.acq_rel, Order.seq_cst)
        c.free(p as *u8)
    }
    0
}
