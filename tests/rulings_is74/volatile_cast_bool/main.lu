//! check: fail(E1307)
//! phase: resolve
//! conforms: mem.unsafe.volatile.1, mem.codes
//!
//! is74 probe: the receiver is the cast itself, `(m as *bool)`; the pointee
//! is read off the cast's type. E1307 on the method.

import c "stdlib.h"

fn main() -> int {
    // # Safety: one live 8-byte allocation, freed once.
    unsafe {
        let m = c.calloc(1, 8)
        let v = (m as *bool).read_volatile()
        c.free(m)
        if v { 1 } else { 0 }
    }
}
