//! check: fail(E1308)
//! phase: resolve
//! conforms: conc.mm.atomic.raw.1
//!
//! is74 probe: `*byte` alone: no arithmetic, so no atomics.

import c "stdlib.h"

fn main() -> int {
    // # Safety: one live 8-byte allocation, aligned, one task.
    unsafe {
        let p = c.calloc(1, 8) as *byte
        let a = p.atomic_swap(1 as byte, Order.seq_cst)
        c.free(p as *u8)
    }
    0
}
