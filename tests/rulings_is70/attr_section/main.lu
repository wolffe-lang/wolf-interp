//! check: fail(E0817)
//! phase: resolve
//! conforms: gram.item.attr
//!
//! kw01 (K13; K6 — wolf-lang#519): `#[section(".text.boot")]` is ruled
//! (K6). Before kw01 the function landed in `.text` with no diagnostic
//! (kw00's `f6_section.lu`): a kernel's boot path would have been linked
//! wherever the linker liked. kw09 implemented it (`[abi.link.section]`);
//! the checked machine and lupin have no image, so the program is refused
//! by name (is73, wolf-interp#190).

#[section(".text.boot")]
fn boot() -> int {
    1
}

fn main() -> int {
    boot() - 1
}
