//! check: fail(E0817)
//! phase: resolve
//! conforms: gram.item.attr, abi.layout.c
//!
//! kw01 (K13, K4 — wolf-lang#519): a representation nothing implements
//! is refused by name, never ignored. kw01 wrote this witness with
//! `#[repr(c, packed)]`, which kw08 implemented (`[abi.layout.packed]`;
//! wolf-interp#188, is73); `transparent` is the one known representation
//! still unimplemented, so the witness asks for it instead, as wolf
//! 0.2.23's `grammar/attr_repr_unimplemented.lu` does.

#[repr(c, transparent)]
struct P {
    a: u8,
    b: u32,
}

fn main() -> int {
    let p = P { a: 1, b: 2 }
    p.b as int - 2
}
