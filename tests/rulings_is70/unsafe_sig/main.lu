//! check: fail(E1302)
//! phase: typecheck
//! conforms: mem.unsafe.scope, mem.unsafe.sig
//! Unsafety never crosses a module's boundary: there are no `unsafe
//! fn`s at v1 — the proof obligation lives at the block, the module is
//! the audit granule, and a `*T` parameter on a `pub` function would
//! smuggle the raw tier into every caller's audit surface. (Since kw02,
//! K9(b) = B: a module-private function and the C membrane take `*T`
//! freely — `raw_ptr_private_sig.lu` — so this row's `peek` is `pub`.)

/// Reads nothing; its signature is the point.
pub fn peek(p: *u8) -> int {       // E1302: `*T` in a `pub` signature
    0
}

fn main() -> !int {
    0
}
