//! is60 (wolffe-lang/wolf-interp#152) — twin, still a trap: `xs[f()] + 1`, `f` → 1 — the index runs first, as the bare form's does.

fn f() -> int {
    print("f")
    1
}

fn bump(mut a: int, n: int) {
    a = a + n
}

fn main() -> !int {
    var xs = [1, 2, 3]
    bump(mut xs[1], xs[f()] + 1)
    print("{xs[1]}")
    0
}
