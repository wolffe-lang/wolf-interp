fn main() -> int {
    print("{size_of(i8)} {size_of(i16)} {size_of(i32)} {size_of(i64)} {size_of(u8)} {size_of(u16)} {size_of(u32)} {size_of(u64)} {size_of(byte)} {size_of(bool)} {size_of(f32)} {size_of(f64)} {size_of(int)} {size_of(uint)}")
    print("{align_of(i8)} {align_of(i16)} {align_of(i32)} {align_of(i64)} {align_of(byte)} {align_of(f32)} {align_of(uint)}")
    0
}
