//! check: run(exit=4)
//! phase: run
//! conforms: gram.pat.let
//!
//! The fix the rule names ([gram.pat.let]): shadow the binding with a
//! `var` at the start of the body, and update that.

enum E { A(int) }

fn f(v: E) -> int {
    match v {
        A(x) => {
            var x = x
            x = x + 1
            x
        },
    }
}

fn main() -> int { f(E.A(3)) }
