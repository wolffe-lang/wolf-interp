//! check: fail(E0410)
//! phase: resolve
//! conforms: gram.pat.let, gram.expr.flow
//!
//! A `for` header's names bind as `let` does ([gram.pat.let]): `x = x *
//! 2` is E0410. Every machine let the body assign it (exit 12).

fn main() -> int {
    var total = 0
    for x in [1, 2, 3] {
        x = x * 2
        total = total + x
    }
    total
}
