//! is67 (#497, the #492 shape under `[type.row.else]`) — a `?` propagating out of the scrutinee leaves the function; the arms never run.

fn key(ok: bool) -> str ! {parse} {
    print("key")
    if ok { "a" } else { return parse }
}

fn look(m: Map[str, int], k: str) -> int ! {none} {
    print("look {k}")
    m[k]
}

fn under(m: Map[str, int], ok: bool) -> int ! {parse} {
    match look(m, key(ok)?) {
        none => -1,
        v => v,
    }
}

fn main() -> !int {
    var m = Map[str, int]()
    m["a"] = 5
    print("{under(m, true) else 9}")
    print("{under(m, false) else 9}")
    0
}
