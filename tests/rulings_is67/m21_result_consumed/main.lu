//! is67 (#497) — the row is consumed: the match's value is a plain `int` an operator may read.
fn look(m: Map[str, int], k: str) -> int ! {none} {
    print("look {k}")
    m[k]
}

fn main() -> !int {
    var m = Map[str, int]()
    m["a"] = 5
    let r = (match look(m, "zz") {
        none => -1,
        v => v,
    }) + 1
    let s = (match look(m, "a") {
        none => -1,
        v => v,
    }) + 1
    print("{r} {s}")
    0
}
