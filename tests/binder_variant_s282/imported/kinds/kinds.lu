//! member: true
//!
//! The enum the entry imports by item, and the function that names it.

/// The kinds of line on a bill.
pub enum Kind { Drink, Food, Gratuity }

/// The name of a kind of line.
pub fn name(k: Kind) -> str {
    match k {
        Drink => "drink",
        Food => "food",
        Gratuity => "tip",
    }
}
