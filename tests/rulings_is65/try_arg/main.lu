fn v(ok: bool) -> int ! {parse} {
    if ok { 5 } else { return parse }
}

fn put(mut xs: List[int], k: int) {
    (mut xs).push(k)
}

fn add(mut xs: List[int], ok: bool) -> int ! {parse} {
    put(mut xs, v(ok)?)
    xs.len
}

fn main() -> !int {
    var xs = [1]
    print("{add(mut xs, true) else 9}")
    print("{add(mut xs, false) else 9}")
    (mut xs).push(3)
    print("{xs}")
    0
}
