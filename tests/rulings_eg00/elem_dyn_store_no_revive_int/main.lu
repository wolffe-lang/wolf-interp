//! check: fail(E1001)
//! phase: typecheck
//! conforms: mem.model.place.elem, mem.tier0.move.2, mem.tier0.move.4
//!
//! eg00 (EGC; RULED, NOT YET BUILT — parked for eg01 (wolffe-lang/wolf-lang#460),
//! with wolffe-lang/wolf-interp#141 for lupin) — `[mem.model.place.elem]` item 3:
//! `move xs[0]; xs[i] = 9` (`i = 1`), then a read of `xs[0]`. A store
//! through a run-time index is not provably the moved element, so it
//! revives nothing (R3 relates only equal spellings over one unassigned
//! local). Today: checked `exit(0)` `1 1 9`; native `exit(0)` `1 1 9`;
//! release `exit(0)` `1 1 9`; lupin 0.1.40 `exit(0)` `1 1 9`. Moves to
//! `corpus/memory/elem_dyn_store_no_revive_int.lu` with the
//! implementation.

fn main() -> !int {
    var xs = [1, 2]
    var i = 1
    let a = move xs[0]
    xs[i] = 9
    print("{a} {xs[0]} {xs[1]}")
    0
}
