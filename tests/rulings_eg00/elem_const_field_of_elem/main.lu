struct Doc {
    id: int,
    tags: List[str],
}

fn main() -> !int {
    var xs = List[Doc]()
    (mut xs).push(Doc { id: 1, tags: ["a"] })
    (mut xs).push(Doc { id: 2, tags: ["b", "c"] })
    let a = move xs[0].tags
    print("{a.len} {xs[1].tags.len}")
    0
}
