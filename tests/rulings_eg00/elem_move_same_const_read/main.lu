//! check: fail(E1001)
//! phase: typecheck
//! conforms: mem.model.place.elem, mem.tier0.move.2
//!
//! eg00 — the moved element itself stays unreadable under every
//! milestone: `move xs[0]` then a read of `xs[0]` is E1001 on both
//! wolfgang lanes, and `[mem.tier0.move.2]`'s dynamic meaning is a
//! `use-after-move` trap. EG1 must keep this red while
//! `elem_move_one_place.lu` (a read of `xs[1]`) turns green.
//!
//! lupin 0.1.40 prints `1 1` and exits 0: it marks the element's slot
//! moved but its index read never consults the mark
//! (wolffe-lang/wolf-interp#141). That is a lupin defect, not a
//! conservatism row; the ruled lupin verdict is the trap.

fn main() -> !int {
    var xs = List[List[int]]()
    (mut xs).push([1])
    (mut xs).push([2, 3])
    let a = move xs[0]
    print("{a.len} {xs[0].len}")   // ERROR E1001: `xs[0]` moved into `a`
    0
}
