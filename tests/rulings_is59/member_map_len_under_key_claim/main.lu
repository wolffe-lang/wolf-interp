//! is59 — 1(c) on a Map: `m.len` read while `m["a"]` is claimed `mut`.
//! The member is the map's header, never an entry. Ruled (wolf-lang#472, A): runs.

fn bump(mut a: int, n: int) {
    a = a + n
}

fn main() -> !int {
    var m = Map[str, int]()
    m["a"] = 1
    m["b"] = 5
    bump(mut m["a"], m.len)
    let a = m["a"] else 0
    print("{a} {m.len}")
    0
}
