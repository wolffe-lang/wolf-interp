//! check: fail(E1002)
//! phase: typecheck
//! conforms: mem.model.place.elem, mem.tier0.excl.1, mem.model.order
//!
//! eg02 (EGC's EG2) — a documented conservatism: `bump(mut xs[0],
//! xs.len)`. Item 1(c) makes an element and a member of its container
//! distinct places, and the moves pass reads it so (`elem_len_after_move.lu`
//! runs). Under a `mut` claim the compiler keeps the member read
//! conflicting, because the oracle does: lupin 0.1.41 traps `exclusivity`
//! here ("`xs` is accessed as `read` while `xs[0]` is held as `mut`") —
//! it reads `.len` as a read of the whole container — and the clause lets
//! the compiler be stricter than lupin, never looser (item 2). E1002 on
//! every wolfgang lane, before and after EG2.

fn bump(mut a: int, n: int) {
    a = a + n
}

fn main() -> !int {
    var xs = [1, 2, 3]
    bump(mut xs[0], xs.len)     // ERROR E1002: a member read under an element claim
    print("{xs[0]} {xs.len}")
    0
}
