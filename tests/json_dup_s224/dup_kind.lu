//! check: run(exit=0, stdout="str array 3\n")
//! phase: run
//! conforms: os.json.dup
//! A repeat may change the member's kind: `json_type` and `json_len`
//! answer the later value's.
//! Ruling B22 (wolf-lang#124): a repeated object name is last-wins.

fn main() -> !int {
    let doc = "{{\"a\": 1, \"a\": \"s\", \"b\": \"t\", \"b\": [1, 2, 3]}}"
    let t = json_type(doc, "a") else |_| "err"
    let u = json_type(doc, "b") else |_| "err"
    let n = json_len(doc, "b") else |_| -1
    print("{t} {u} {n}")
    0
}
