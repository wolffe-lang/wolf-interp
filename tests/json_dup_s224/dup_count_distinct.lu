//! check: run(exit=0, stdout="3 2\n")
//! phase: run
//! conforms: os.json.dup
//! `json_len` counts distinct names: three members written, two names.
//! Ruling B22 (wolf-lang#124): a repeated object name is last-wins.

fn main() -> !int {
    let doc = "{{\"a\": 1, \"b\": 2, \"a\": 3}}"
    let v = json_get(doc, "a") else |_| "err"
    let n = json_len(doc, "") else |_| -1
    print("{v} {n}")
    0
}
