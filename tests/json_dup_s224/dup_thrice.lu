//! check: run(exit=0, stdout="5 6 3\n")
//! phase: run
//! conforms: os.json.dup
//! A name repeated three times reads its third value; two names repeat
//! interleaved and each keeps its own last value.
//! Ruling B22 (wolf-lang#124): a repeated object name is last-wins.

fn main() -> !int {
    let doc = "{{\"a\": 1, \"b\": 2, \"a\": 3, \"c\": 4, \"a\": 5, \"b\": 6}}"
    let a = json_get(doc, "a") else |_| "err"
    let b = json_get(doc, "b") else |_| "err"
    let n = json_len(doc, "") else |_| -1
    print("{a} {b} {n}")
    0
}
