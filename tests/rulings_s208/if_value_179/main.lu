//! check: run(exit=0, stdout="() ()\n")
//! phase: run
//! conforms: type.unit.context, type.unit.discard, diag.sev.warn
//! warns: W0601
//!
//! s207 (wolf-lang#541) — an `if` with no `else` is a unit context for
//! its then-block, and "the block's value is `()` whatever the tail's
//! type" (`[type.unit.context]`). So `v` is `()` whether `maybe` answers
//! a value or raises. Native and release print `() ()`; the checked
//! machine bound the value and then the row (`3 none`) until s207.
//! lupin 0.1.44 prints `3 none` and is68's lupin `() none`
//! (wolf-interp, filed by s207).

fn maybe(n: int) -> int ! {none} {
    if n > 5 { return none }
    n
}

fn main() -> !int {
    let v = if true { maybe(3) }
    let w = if true { maybe(9) }
    print("{v} {w}")
    0
}
