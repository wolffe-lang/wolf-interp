//! check: fail(E1001)
//! phase: typecheck
//! conforms: mem.tier0.move.3, mem.tier0.move.2
//! s252 (wolf-lang#813): what the adapter rule leaves alone. An
//! adapter copies only when its base is a `Copy` scalar; an adapter of
//! a `List` moves as the `List` does, so the second binding reads a
//! moved-from place (lupin 0.1.54: `trap(use-after-move)`).

type Ids = distinct List[int]

fn twice(a: Ids) -> int {
    let x = a
    let y = a
    (x as List[int]).len + (y as List[int]).len
}

fn main() {
    var xs = List[int]()
    (mut xs).push(1)
    print("{twice(xs as Ids)}")
}
