//! check: run(exit=0, stdout="poll_outside=io\npoll_past_table=io\npoll_quiet_user=0\nignore_kill=io\ndefault_past_table=io\nsend_pid_zero=invalid\nsend_pid_negative=invalid\nsend_two_bits=invalid\nsend_past_table=invalid\nsend_wide_pid=invalid\nnumber_two_bits=invalid\nnumber_zero=invalid\nnumber_interrupt: true\nnumber_kill: true\npid: true\nppid: true")
//! phase: run
//! conforms: os.signal.set, os.signal.poll, os.signal.disp, os.signal.send, os.signal.number, os.proc.self, err.union
//!
//! s232 (wolf-lang#679, #141; pelt's `trap`, `kill`, `$$`, `$PPID`) — the
//! rows of the shell's signal surface that signal nothing and need no
//! child, one truth on every host. The one shape rule: a set holding a
//! bit that is not a listenable meaning (`KILL`, 1048576, is send-only;
//! 2^40 is past the table) is `io` and changes nothing, where 512 is
//! `USER` now and a poll of it answers 0. A send is refused by its shape
//! (`invalid`) before the host is asked: a pid not above 0 or wider
//! than a process id, a meaning with two bits or past the table. A
//! number is `invalid` for anything but one meaning; `INTERRUPT` is
//! signal 2 and `KILL` signal 9 on every unix host (XCU `kill`), and
//! windows has no numbers (`unsupported`, answered true here). This
//! process has an id above 0, and a parent unless the host has no such
//! call. The live witnesses — a send that ends a child, a disposition
//! read at start, the poll after a reap — are
//! `crates/wolf_driver/tests/signal_shell_lanes.rs` (unix).

fn set_row(name: str, set: int) -> str {
    var r = "ok"
    if name == "poll" {
        let got = os_signal_poll(set) else |_| { return "io" }
        return "{got}"
    }
    if name == "ignore" {
        os_signal_ignore(set) else |e| {
            r = match e {
                io => "io",
                unsupported => "unsupported",
            }
        }
        return r
    }
    os_signal_default(set) else |e| {
        r = match e {
            io => "io",
            unsupported => "unsupported",
        }
    }
    r
}

fn send_row(pid: int, m: int) -> str {
    os_signal_send(pid, m) else |e| {
        return match e {
            unsupported => "unsupported",
            invalid => "invalid",
            not_found => "not_found",
            denied => "denied",
            io => "io",
        }
    }
    "ok"
}

/// The number, -1 for `invalid`, -2 for `unsupported`.
fn number(m: int) -> int {
    let n = os_signal_number(m) else |e| {
        return match e {
            invalid => -1,
            unsupported => -2,
        }
    }
    n
}

fn main() -> !int {
    print("poll_outside={set_row("poll", 1048576)}")
    print("poll_past_table={set_row("poll", 1099511627776)}")
    print("poll_quiet_user={set_row("poll", 512)}")
    print("ignore_kill={set_row("ignore", 1048576)}")
    print("default_past_table={set_row("default", 1099511627776)}")
    print("send_pid_zero={send_row(0, 0)}")
    print("send_pid_negative={send_row(-1, 2)}")
    print("send_two_bits={send_row(1, 3)}")
    print("send_past_table={send_row(1, 268435456)}")
    print("send_wide_pid={send_row(1099511627776, 0)}")
    print(if number(3) == -1 { "number_two_bits=invalid" } else { "number_two_bits=?" })
    print(if number(0) == -1 { "number_zero=invalid" } else { "number_zero=?" })
    let ni = number(16)
    print("number_interrupt: {ni == 2 || ni == -2}")
    let nk = number(1048576)
    print("number_kill: {nk == 9 || nk == -2}")
    print("pid: {os_pid() > 0}")
    let pp = os_ppid() else |_| { 1 }
    print("ppid: {pp > 0}")
    0
}
