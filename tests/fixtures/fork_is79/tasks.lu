//! member: false
//! s247 (`[os.proc.fork]`; ruling asked: the `busy` rule) — the fork and the
//! pool. While a task is parked in a channel receive, a fork from `main`
//! answers `busy`; from inside a task it is `busy` too. Once the scope has
//! ended (every task done, the workers idle and held for the fork), it
//! forks, and the child's pool — empty, its threads the parent's — is made
//! again by the child's first spawn: three tasks run and sum to 6. Then
//! 300 times a scope of one task and, right after it, a fork: a task done
//! is not live once its scope's join has returned (never `busy`; the count
//! drops before the join can see the scope's last child done).

fn main() -> !int {
    let ch = channel[int](0)
    var inner = ""
    scope s {
        s.spawn(fn() {
            let _ = ch.recv() else |_| 0
        })
        time_sleep_ms(50)
        let _ = os_fork() else |e| {
            print("tasks: a fork with a task parked: {e}")
            (0, 0)
        }
        ch.send(1)?
    }
    let out = channel[str](1)
    scope s {
        s.spawn(fn() {
            let _ = os_fork() else |e| {
                out.send("{e}") else |_| {}
                (0, 0)
            }
        })
    }
    inner = out.recv() else |_| "none"
    print("tasks: a fork from inside a task: {inner}")
    let (pid, h) = os_fork()?
    if pid == 0 {
        let sum = channel[int](3)
        scope s {
            for i in 1..=3 {
                s.spawn(fn() {
                    sum.send(i) else |_| {}
                })
            }
        }
        sum.close()
        var t = 0
        for v in sum {
            t += v
        }
        print("tasks: the child's own tasks ran, sum {t}")
        os_exit(0)
    }
    let st = os_wait_status(h)?
    print("tasks: after the scope a fork works, child status {st}")
    var busy = 0
    var n = 0
    while n < 300 {
        scope s {
            s.spawn(fn() {
                let _ = 1
            })
        }
        let (p2, h2) = os_fork() else |e| {
            busy += 1
            (1, 0 - 1)
        }
        if p2 == 0 {
            os_exit(0)
        }
        if h2 >= 0 {
            let _ = os_wait_status(h2) else 0
        }
        n += 1
    }
    print("tasks: a fork right after each of 300 one-task scopes: busy {busy} times")
    0
}
