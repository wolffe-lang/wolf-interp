//! member: false
//! s215 (`[os.fs.chdir]`, `[os.proc.fds]`) — a child starts in the
//! working directory the program moved to: after `os_chdir`, a plain
//! `ls` lists the new directory. On the checked machine the directory
//! is machine-local (it runs inside test hosts that cannot `chdir`), so
//! this is what proves the spawn honours it. Unix only.

/// Every byte the pipe carries until its last writer closes, as text;
/// a failure ends the read and is named in the text.
fn drain(fd: int) -> str {
    var out = ""
    loop {
        var stop = false
        let chunk = fs_read(fd, 4096) else |e| {
            stop = true
            match e {
                eof => "",
                io => "<io>",
                utf8 => "<utf8>",
            }
        }
        out = out + chunk
        if stop {
            break
        }
    }
    out
}

fn main() -> !int {
    fs_create_dir_all("target/s215-cdspawn")?
    fs_write_text("target/s215-cdspawn/mark.txt", "x")?
    let start = os_cwd()?
    os_chdir("target/s215-cdspawn")?
    let (r, w) = os_pipe()?
    let h = os_spawn_fds("ls", List[str](), [1, w])?
    fs_close(w)?
    let out = drain(r)
    fs_close(r)?
    let code = os_wait(h)?
    os_chdir(start)?
    fs_remove_dir_all("target/s215-cdspawn")?
    let listed = out.trim()
    print("child_lists={listed} code={code}")
    0
}
