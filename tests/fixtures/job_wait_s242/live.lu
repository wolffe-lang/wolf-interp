//! member: false
//! s242 (wolf-lang#680; `[os.proc.poll]`) — the poll with a live child,
//! on a unix host, nothing signalled: a child that exits 7 is reported
//! once, `(h, 7)`, and reaped; then `(-1, 0)`. The first poll, before
//! any child, is `(-1, 0)` on every machine; lupin answers it and
//! refuses the second by name (its standard library's `try_wait` cannot
//! see a stop). Red at 0.2.30: `os_wait_poll` did not exist.

fn main() -> !int {
    let (h0, n0) = os_wait_poll()?
    print("before any child: ({h0}, {n0})")
    let c = os_spawn(["sh", "-c", "exit 7"])?
    var r = os_wait_poll()?
    var i = 0
    while r.0 == -1 && i < 500 {
        time_sleep_ms(10)
        r = os_wait_poll()?
        i = i + 1
    }
    print("a child that exits 7: reported: {r.0 == c}, its code: {r.1}")
    let (h1, n1) = os_wait_poll()?
    print("then: ({h1}, {n1})")
    0
}
