fn f(mut xs: List[int], n: int) {
    var i = 0
    while i < n {
        i = i + 1
        if i == 1 {
            var t = move xs
            (mut t).push(9)
            continue
        }
        print("{i}")
    }
}

fn main() -> !int {
    var xs = [1]
    f(mut xs, 0)
    print("{xs.len}")
    0
}
