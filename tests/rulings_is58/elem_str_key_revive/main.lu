//! check: run(exit=0, stdout="3 7 2\n")
//! phase: run
//! conforms: mem.model.place.elem, mem.tier0.move.4
//!
//! eg01b — `[mem.model.place.elem]` item 4's R3 over a `Copy` local
//! that is not an integer (the maintainer's ruling, 2026-09-26): read a
//! value out of a `Map[str, List[int]]` through a `str` key, work on it,
//! store it back through the SAME key. `k` is unwritten between, so the
//! store provably denotes the element the read emptied and revives it.
//! Both spellings: a key parameter (`bump`) and a key local (`main`).
//!
//! 0.2.17 accepted this through any-store revival (wolf-lang#460);
//! eg01 narrowed revival to R3 over integer locals and refused it
//! (E1001 at `main`'s read after the store). `3 7 2` on checked,
//! native, release and lupin 0.1.40.

fn bump(mut m: Map[str, List[int]], k: str, x: int) {
    var v = m[k] else List[int]()
    (mut v).push(x)
    m[k] = take v
}

fn main() -> !int {
    var m = Map[str, List[int]]()
    bump(mut m, "a", 1)
    bump(mut m, "a", 2)
    bump(mut m, "b", 3)
    let k = "a"
    var v = m[k] else List[int]()
    (mut v).push(7)
    m[k] = take v
    let a = m[k] else List[int]()
    print("{a.len} {a[2]} {m.len}")
    0
}
