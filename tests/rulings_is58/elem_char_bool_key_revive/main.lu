//! check: run(exit=0, stdout="2 2 2 4\n")
//! phase: run
//! conforms: mem.model.place.elem, mem.tier0.move.4
//!
//! eg01b — R3 over `char` and `bool` key locals, the twin of
//! `elem_str_key_revive.lu`: out through `bc[c]` / `bb[f]`, back through
//! the same local, read. Any `Copy` local qualifies, not only an integer
//! one. 0.2.17 accepted it through any-store revival (wolf-lang#460);
//! eg01 refused it (E1001). `2 2 2 4` on every machine.

fn main() -> !int {
    var bc = Map[char, List[int]]()
    bc['x'] = [1]
    let c = 'x'
    var v = bc[c] else List[int]()
    (mut v).push(2)
    bc[c] = take v
    var bb = Map[bool, List[int]]()
    bb[true] = [3]
    let f = true
    var w = bb[f] else List[int]()
    (mut w).push(4)
    bb[f] = take w
    let x = bc[c] else List[int]()
    let y = bb[f] else List[int]()
    print("{x.len} {x[1]} {y.len} {y[1]}")
    0
}
